---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: { project, index, total: projects.length },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const prev = projects[(index - 1 + total) % total];
const next = projects[(index + 1) % total];
const { name, period, summary, thesis, context, flow, decisions, checks, outcome, responsibility, stack, metrics } =
  project.data;
const caseNo = String(index + 1).padStart(2, '0');
---
<BaseLayout title={name} description={summary} type="article">
  <article class="case wrap">
    <header class="head">
      <p class="kicker">案例 {caseNo} · 工程细节</p>
      <h1>{name}</h1>
      <p class="thesis">{thesis}</p>
      <p class="meta">{period} · 公司项目（已脱敏）</p>
    </header>

    <section class="block">
      <h2>问题与约束</h2>
      <p class="body-text">{context}</p>
    </section>

    {flow.length > 0 && (
      <section class="block">
        <h2>核心链路</h2>
        <p class="note">以下为技术思路的简化示意。</p>
        <ol class="flow">
          {flow.map((step) => (
            <li>
              <b>{step.name}</b>
              <span>{step.detail}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {decisions.length > 0 && (
      <section class="block">
        <h2>架构取舍与实现</h2>
        <ol class="decisions">
          {decisions.map((item, i) => (
            <li class="decision">
              <div class="decision-head">
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{item.title}</h3>
              </div>
              <dl class="tradeoff">
                <dt>难点</dt>
                <dd>{item.problem}</dd>
                <dt>方案</dt>
                <dd>{item.choice}</dd>
                <dt>考虑</dt>
                <dd>{item.benefit}</dd>
              </dl>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="block">
      <h2>这套设计解决了什么</h2>
      <p class="outcome">{outcome}</p>
      {metrics.length > 0 && (
        <ul class="metrics" aria-label="成果">
          {metrics.map((metric) => <li>{metric}</li>)}
        </ul>
      )}
    </section>

    {checks.length > 0 && (
      <section class="block">
        <h2>验证关注点</h2>
        <ul class="checks">
          {checks.map((check) => <li>{check}</li>)}
        </ul>
      </section>
    )}

    <section class="block">
      <h2>我的职责</h2>
      <p class="body-text">{responsibility}</p>
    </section>

    <section class="block">
      <h2>技术与主题</h2>
      <ul class="stack" aria-label="技术栈">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <nav class="case-nav" aria-label="其他案例">
      <a href={`/projects/${prev.id}/`}>
        <span class="nav-label">上一个案例</span>
        <strong>{prev.data.name}</strong>
        <span class="nav-desc">{prev.data.thesis}</span>
      </a>
      <a href={`/projects/${next.id}/`}>
        <span class="nav-label">下一个案例</span>
        <strong>{next.data.name}</strong>
        <span class="nav-desc">{next.data.thesis}</span>
      </a>
    </nav>

    <footer class="foot">
      <a href="/#projects">返回项目列表</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .case {
    max-width: 48rem;
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .head h1 {
    margin-top: 0.9rem;
    font-size: clamp(2rem, 4.8vw, 2.9rem);
  }

  .thesis {
    max-width: 40ch;
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 2.2vw, 1.36rem);
    line-height: 1.55;
  }

  .meta {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .block {
    margin-top: clamp(2.6rem, 6vw, 3.8rem);
  }

  .block h2 {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: 1.4rem;
  }

  .note {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .body-text {
    max-width: 62ch;
    margin-top: 1.1rem;
    font-size: 0.98rem;
    line-height: 1.85;
  }

  /* Flow ---------------------------------------------------------- */
  .flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .flow li {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .flow li::before {
    counter-increment: step;
    content: '0' counter(step);
    display: block;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .flow b {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .flow span {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  /* Decisions ----------------------------------------------------- */
  .decisions {
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .decision + .decision {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .decision-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .num {
    flex: none;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .decision h3 {
    font-size: 1.1rem;
  }

  .tradeoff {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0.55rem 1rem;
    margin: 0.9rem 0 0 1.6rem;
  }

  .tradeoff dt {
    padding-top: 0.12em;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .tradeoff dd {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.78;
  }

  /* Outcome ------------------------------------------------------- */
  .outcome {
    max-width: 62ch;
    margin-top: 1.2rem;
    padding: 0.9rem 0 0.9rem 1.1rem;
    border-left: 2px solid var(--seal);
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .metrics li {
    position: relative;
    padding-left: 0.9rem;
    font-size: 0.85rem;
  }

  .metrics li::before {
    content: '';
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 7px;
    height: 1.5px;
    background: var(--seal);
  }

  /* Checks -------------------------------------------------------- */
  .checks {
    max-width: 62ch;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .checks li + li {
    margin-top: 0.5rem;
  }

  .checks li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 6px;
    height: 6px;
    background: var(--seal);
  }

  /* Stack --------------------------------------------------------- */
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.08em 0.5em;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.7;
  }

  /* Case nav ------------------------------------------------------ */
  .case-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .nav-label {
    display: block;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .case-nav strong {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .case-nav a:hover strong {
    color: var(--accent);
  }

  .nav-desc {
    display: block;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .case-nav a:last-child {
    text-align: right;
  }

  .foot {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .foot a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .foot a:hover {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tradeoff {
      grid-template-columns: 1fr;
      gap: 0.15rem;
      margin-left: 0;
    }

    .tradeoff dd + dt {
      margin-top: 0.55rem;
    }

    .case-nav {
      grid-template-columns: 1fr;
    }

    .case-nav a:last-child {
      text-align: left;
    }
  }
</style>
