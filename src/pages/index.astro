---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SkillTiers from '../components/SkillTiers.astro';
import BackToTop from '../components/BackToTop.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { site, experience, capabilities, explorations } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = [
  { key: 'all', label: '全部' },
  { key: 'ai', label: 'AI 应用' },
  { key: 'business', label: '业务系统' },
  { key: 'infra', label: '工程基建' },
  { key: 'cross-platform', label: '跨端应用' },
] as const;
const categoryCounts = projects.reduce<Record<string, number>>((acc, project) => {
  acc[project.data.category] = (acc[project.data.category] ?? 0) + 1;
  return acc;
}, {});
const featuredCategories = ['ai', 'business', 'infra', 'cross-platform'] as const;
const featured = featuredCategories
  .map((key) => projects.find((project) => project.data.category === key))
  .filter((project): project is CollectionEntry<'projects'> => Boolean(project));
const categoryLabels = Object.fromEntries(
  categories.filter((category) => category.key !== 'all').map((category) => [category.key, category.label]),
) as Record<string, string>;

const statusClasses: Record<string, string> = {
  学习中: 'learning',
  实验中: 'experimenting',
  规划中: 'planned',
  已有公开代码: 'open',
};
---
<BaseLayout>
  <section class="hero">
    <svg
      class="hero-schematic"
      viewBox="0 0 300 640"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="xMidYMin meet"
    >
      <path class="trace" pathLength="1" d="M234 -24V120H194V238H266V404H222V664"></path>
      <path class="branch" d="M234 64H286M286 56V72M194 176H160M160 168V184M266 316H292M292 308V324"></path>
      <path
        class="ticks"
        d="M240 10h7M240 42h7M240 74h7M240 106h7M188 150h-7M188 180h-7M188 210h-7M273 268h7M273 300h7M273 332h7M273 364h7M273 396h7M215 436h-7M215 470h-7M215 504h-7M215 538h-7M215 572h-7M215 606h-7"
      ></path>
      <path class="guide" d="M150 -24V664" stroke-dasharray="2 6"></path>
      <rect class="node" x="230.5" y="116.5" width="7" height="7" fill="currentColor" stroke="none"></rect>
      <rect class="node" x="190.5" y="234.5" width="7" height="7" fill="currentColor" stroke="none"></rect>
      <rect class="node" x="262.5" y="400.5" width="7" height="7" fill="currentColor" stroke="none"></rect>
      <text class="label" x="240" y="140">A-01</text>
      <text class="label" x="274" y="352">C-03</text>
    </svg>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker">软件工程师 · 工程化 / AI 应用</p>
        <h1 class="hero-title">
          <span>软件工程师，</span>
          <span>专注工程化与 AI 应用。</span>
        </h1>
        <p class="hero-intro">{site.intro}</p>
        <p class="hero-now">
          <span class="status-dot" aria-hidden="true"></span>
          {site.now}
        </p>
        <div class="hero-actions">
          <a class="btn btn-solid" href="#projects">查看项目</a>
          <a class="btn btn-ghost" href="/resume/">查看简历</a>
          <a class="hero-mail" href={`mailto:${site.email}`}>或直接来信</a>
        </div>
        <ul class="hero-stats" aria-label="概览">
          <li>
            <strong>3 年</strong>
            <span>开发经验</span>
          </li>
          <li>
            <strong>4 个</strong>
            <span>从 0 到 1 的项目</span>
          </li>
          <li>
            <strong>10+</strong>
            <span>组件库服务的产品线</span>
          </li>
        </ul>
      </div>

      <div class="hero-portrait">
        <img
          src={site.avatar}
          alt="榕的头像"
          width="220"
          height="220"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="cap-title">
    <div class="section-head">
      <h2 id="cap-title">我解决的问题</h2>
      <p class="section-note">从项目里抽出的能力，不是技能标签</p>
    </div>
    <div class="cap-grid">
      {capabilities.map((cap) => (
        <article class="cap">
          <span class="cap-index">{cap.index}</span>
          <h3>{cap.title}</h3>
          <p class="cap-detail">{cap.detail}</p>
          <p class="cap-proof">{cap.proof}</p>
          <a class="cap-link" href={cap.href}>{cap.linkLabel}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="feature wrap" aria-labelledby="feature-title">
    <div class="feature-head">
      <div>
        <p class="feature-kicker">案例速览</p>
        <h2 id="feature-title">一条链路，看清一个项目。</h2>
      </div>
      <p class="section-note">按分类切换 · 流程为技术示意，非产品截图</p>
    </div>

    <div class="feature-switch" role="group" aria-label="选择案例分类">
      {featured.map((project, i) => (
        <button
          type="button"
          class:list={['feature-btn', { 'is-active': i === 0 }]}
          data-feature={project.data.category}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {categoryLabels[project.data.category] ?? project.data.category}
        </button>
      ))}
    </div>

    {featured.map((project, i) => (
      <article
        class="feature-panel"
        data-panel={project.data.category}
        hidden={i !== 0}
        aria-label={project.data.name}
      >
        <div class="feature-flow-wrap">
          <p class="feature-flow-label">核心链路 · 技术示意</p>
          <div class="feature-flow" aria-label="核心链路">
            {project.data.flow.map((step, stepIndex) => (
              <div class="feature-step">
                <span class="feature-num">{String(stepIndex + 1).padStart(2, '0')}</span>
                <b>{step.name}</b>
                <span class="feature-detail">{step.detail}</span>
              </div>
            ))}
          </div>
          <p class="feature-flow-note">周期为参与区间，部分项目并行推进。</p>
        </div>

        <div class="feature-body">
          <p class="feature-meta">{project.data.period} · {project.data.role}</p>
          <h3>{project.data.name}</h3>
          <p class="feature-thesis">{project.data.thesis}</p>
          <p class="feature-summary">{project.data.summary}</p>
          <ul class="feature-metrics" aria-label="关键结果">
            {project.data.metrics.slice(0, 2).map((metric) => <li>{metric}</li>)}
          </ul>
          <a class="feature-link" href={`/projects/${project.id}/`}>阅读完整案例</a>
        </div>
      </article>
    ))}
  </section>

  <section id="projects" class="section wrap">
    <div class="section-head">
      <h2>项目</h2>
      <p class="section-note">{projects.length} 个公司项目 · 内容已脱敏</p>
    </div>
    <p class="projects-note">
      部分项目在时间上并行推进；周期为参与区间，不代表全职投入时长。每篇案例区分了主导设计、独立负责与协作参与。
    </p>
    <div class="filters" role="group" aria-label="按类型筛选项目">
      {categories.map((category) => (
        <button
          type="button"
          class:list={['filter', { 'is-active': category.key === 'all' }]}
          data-filter={category.key}
          aria-pressed={category.key === 'all' ? 'true' : 'false'}
        >
          {category.label}
          <span>{category.key === 'all' ? projects.length : (categoryCounts[category.key] ?? 0)}</span>
        </button>
      ))}
    </div>
    <div class="project-list" id="project-list">
      {projects.map((project) => <ProjectRow project={project} />)}
    </div>
    <p class="filter-empty" hidden>这个分类下还没有项目。</p>
  </section>

  <section id="experience" class="section wrap">
    <div class="section-head">
      <h2>经历</h2>
      <a class="section-link" href="/about/">完整经历</a>
    </div>
    <ul class="timeline">
      {experience.map((job) => (
        <li class="job-row">
          <div class="job-head">
            <span class="job-period">{job.period}</span>
            <span class="job-company">{job.company}</span>
            <span class="job-role">{job.role}</span>
          </div>
          <p class="job-desc">{job.summary}</p>
          <ul class="job-points">
            {job.points.slice(0, 2).map((point) => <li>{point}</li>)}
          </ul>
          <ul class="job-tags" aria-label="关键词">
            {job.keywords.map((keyword) => <li>{keyword}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section id="stack" class="section wrap">
    <div class="section-head">
      <h2>技术能力</h2>
      <p class="section-note">按真实使用程度分层</p>
    </div>
    <p class="stack-note">
      分层依据是项目证据，不按熟练度自评。项目实战之外的技术会明确标注；学习中的方向不会写成生产经验。
    </p>
    <SkillTiers layout="grid" />
  </section>

  <section id="exploring" class="section wrap">
    <div class="section-head">
      <h2>技术探索</h2>
      <a class="section-link" href="/lab/">查看探索页</a>
    </div>
    <p class="explore-intro">
      以下不是已交付项目，是正在学习、规划或验证的方向；没有代码与验证结果的内容不会写成项目经历。
    </p>
    <div class="explore-grid">
      {explorations.map((item) => (
        <article class="explore-card">
          <span class:list={['explore-status', `is-${statusClasses[item.status]}`]}>{item.status}</span>
          <h3>{item.title}</h3>
          <p class="explore-summary">{item.summary}</p>
          <ul class="explore-plans">
            {item.plans.slice(0, 3).map((plan) => <li>{plan}</li>)}
          </ul>
          <p class="explore-boundary">{item.boundary}</p>
          <a class="explore-link" href={`/lab/#${item.id}`}>查看探索记录</a>
        </article>
      ))}
    </div>
  </section>

  <section id="cooperate" class="section wrap">
    <div class="section-head">
      <h2>求职与合作</h2>
      <a class="section-link" href="/services/">查看合作方式</a>
    </div>
    <div class="coop-primary">
      <div class="coop-primary-copy">
        <p class="coop-kicker">优先 · 全职</p>
        <h3>寻找前端 / 全栈 / AI 应用方向的全职机会</h3>
        <p>
          目标岗位：前端开发、全栈开发（前端为主）、AI 应用开发，以及工业软件 / FDE 方向。
          目前在安徽，可到岗；具体岗位与到岗时间可以邮件沟通。
        </p>
      </div>
      <div class="coop-actions">
        <a class="btn btn-solid" href={`mailto:${site.email}`}>发送岗位或约聊</a>
        <a class="btn btn-ghost" href="/resume/">查看简历</a>
      </div>
    </div>
    <div class="coop-secondary">
      <div class="coop-item">
        <span class="coop-index">02</span>
        <h3>远程协作</h3>
        <p>远程全职或长期协作，按周同步，以文档、代码和演示推进。</p>
      </div>
      <div class="coop-item">
        <span class="coop-index">03</span>
        <h3>项目制合作</h3>
        <p>需求明确的页面、系统、组件库或 AI 应用，按阶段交付与验收。</p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="contact">
      <div>
        <h2>聊聊</h2>
        <p class="contact-lead">
          目前优先寻找全职机会，也接受远程协作与项目制合作。如果我的项目或经历匹配你正在招的岗位，欢迎来信；
          也欢迎在 GitHub 上交流。
        </p>
      </div>
      <div class="contact-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href="/resume/">简历</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>

  <BackToTop />
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const projectRows = document.querySelectorAll<HTMLElement>('#project-list [data-category]');
  const emptyState = document.querySelector<HTMLElement>('.filter-empty');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.filter;

      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      let visible = 0;
      projectRows.forEach((row) => {
        const show = key === 'all' || row.dataset.category === key;
        row.hidden = !show;
        if (show) visible += 1;
      });

      if (emptyState) emptyState.hidden = visible > 0;
    });
  });

  const featureButtons = document.querySelectorAll<HTMLButtonElement>('[data-feature]');
  const featurePanels = document.querySelectorAll<HTMLElement>('[data-panel]');

  featureButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.feature;

      featureButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      featurePanels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== key;
      });
    });
  });
</script>

<style>
  /* Hero ---------------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-schematic {
    position: absolute;
    top: -32px;
    right: clamp(1rem, 6vw, 5rem);
    z-index: 0;
    height: calc(100% + 64px);
    width: auto;
    color: var(--accent);
    opacity: 0.45;
    pointer-events: none;
  }

  .hero-schematic .trace,
  .hero-schematic .branch,
  .hero-schematic .ticks,
  .hero-schematic .guide {
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .hero-schematic .trace {
    stroke-width: 1.15;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.7s cubic-bezier(0.22, 0.61, 0.36, 1) 0.1s forwards;
  }

  .hero-schematic .branch {
    stroke-width: 1;
    opacity: 0.55;
  }

  .hero-schematic .ticks {
    stroke-width: 0.9;
    opacity: 0.5;
  }

  .hero-schematic .guide {
    stroke-width: 0.8;
    opacity: 0.25;
  }

  .hero-schematic .label {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.12em;
    opacity: 0.7;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(4rem, 11vw, 7.5rem);
  }

  .hero-kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .hero-title {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 6.2vw, 4.4rem);
    line-height: 1.06;
  }

  .hero-title span {
    display: block;
  }

  .hero-intro {
    max-width: 48ch;
    margin-top: 1.6rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .hero-now {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .status-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--seal);
    transform: translateY(-1px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.1rem;
    margin-top: 2.2rem;
  }

  .hero-mail {
    color: var(--muted);
    font-size: 0.86rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .hero-mail:hover {
    color: var(--accent);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0 clamp(2rem, 5vw, 3.4rem);
    margin: 2.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .hero-stats span {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.68rem 1.35rem;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: 0.92rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn-solid {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-solid:hover {
    background: var(--accent);
  }

  .btn-ghost {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero-portrait {
    position: relative;
    justify-self: end;
  }

  .hero-portrait img {
    width: clamp(150px, 20vw, 220px);
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }

  .hero-portrait::after {
    content: '';
    position: absolute;
    inset: -12px;
    border: 1px dashed var(--line-strong);
    border-radius: 50%;
  }

  /* Sections ------------------------------------------------------ */
  .section {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.3rem;
  }

  .section-head h2 {
    font-size: 1.6rem;
  }

  .section-note {
    color: var(--muted);
    font-size: 0.86rem;
  }

  .section-link {
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .section-link:hover {
    color: var(--accent);
  }

  /* Capabilities -------------------------------------------------- */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 2.5rem;
  }

  .cap {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .cap:nth-child(1),
  .cap:nth-child(3) {
    border-top-color: var(--accent);
  }

  .cap-index {
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .cap h3 {
    margin-top: 0.45rem;
    font-size: 1.1rem;
  }

  .cap-detail {
    max-width: 52ch;
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .cap-proof {
    margin-top: 0.7rem;
    color: var(--ink);
    font-size: 0.8rem;
  }

  .cap-link {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .cap-link:hover {
    color: var(--accent);
  }

  /* Feature case --------------------------------------------------- */
  .feature {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .feature-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin-bottom: 1.4rem;
  }

  .feature-kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .feature-head h2 {
    margin-top: 0.45rem;
    font-size: 1.6rem;
  }

  .feature-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.3rem;
    margin-bottom: 1.1rem;
  }

  .feature-btn {
    position: relative;
    padding: 0.4rem 0;
    color: var(--muted);
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .feature-btn::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1.5px;
    background: transparent;
  }

  .feature-btn:hover {
    color: var(--ink);
  }

  .feature-btn.is-active {
    color: var(--ink);
  }

  .feature-btn.is-active::after {
    background: var(--seal);
  }

  .feature-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3rem);
