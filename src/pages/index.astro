---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectBlueprint from '../components/ProjectBlueprint.astro';
import { getCollection } from 'astro:content';
import { site, experience, education, capabilities, explorations } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredIds = ['smart-warehouse', 'ai-platform', 'aui-components'];
const featured = featuredIds.flatMap((id) => {
  const project = projects.find((item) => item.id === id);
  return project ? [project] : [];
});
const archive = projects.filter((project) => !featuredIds.includes(project.id));
const categories = [
  { key: 'all', label: '全部项目' },
  { key: 'business', label: '业务系统' },
  { key: 'ai', label: 'AI 应用' },
  { key: 'infra', label: '工程基建' },
  { key: 'cross-platform', label: '跨端应用' },
];
const summaries: Record<string, string> = {
  'smart-warehouse': '扫码、离线缓存与增量同步，让弱网下的仓储作业继续运行。',
  'ai-platform': '统一模型接入、会话交互与权限，打通前端和 Spring Boot 服务。',
  'aui-components': '把组件、测试、文档与发布，放进一套可复用的工程体系。',
};
const archiveSummaries: Record<string, string> = {
  'smart-materials': 'Vue 迁移 · 实时通信 · AI 分析',
  'cms-platform': '内容编排 · 多端分发 · 平台建设',
  'lowcode-platform': '可视化搭建 · 组件协议 · 工程化',
};
const capabilityTitles = ['复杂业务系统', '前端工程基建', '全栈与 AI 接入', '跨端与现场作业'];
const capabilityDetails = [
  '从多角色权限到审批流，先理清物流、仓储和物资管理的业务边界。',
  '组件库、Monorepo、测试与 CI/CD，让多人协作和多产品线复用有据可循。',
  '用 Spring Boot、Redis 与 RabbitMQ，连接模型 API、认证和异步链路。',
  '处理扫码、离线同步和平台差异，让现场作业适应真实的网络条件。',
];
---
<BaseLayout description="榕（RickRone）的工程作品集：近 4 年 ToB 企业级开发经验，前端为主，也写 Java 后端。项目覆盖物流、智慧仓储、AI 应用与工程化基建。">
  <!-- Industrial workbench: approved grey, charcoal and signal orange.
       Public Sans; one load entrance and the dealt word-highlight moment. -->
  <section class="hero" data-enter aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <div class="hero-topline">
        <span><span class="square" aria-hidden="true"></span> 工程作品集</span>
        <span class="mono">RickRone / 2026</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">榕 · ToB 全栈开发工程师</p>
          <h1 id="hero-title">工业互联网，<br />从界面到服务<span class="title-stop">。</span></h1>
          <p class="hero-intro">前端为主，也写 Java 后端。<br />在物流、仓储与 AI 应用里，把业务链路接起来。</p>
          <div class="hero-actions">
            <a class="btn btn--primary" href="#projects">查看项目 <span aria-hidden="true">↗</span></a>
            <a class="btn btn--secondary" href="/resume/">查看简历 <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-status"><span class="square" aria-hidden="true"></span> 近 4 年企业级研发经验 · 在职，关注新的机会</p>
        </div>
        <aside class="workbench" data-enter-media aria-label="个人信息与交付链路">
          <div class="bench-header"><span class="mono">工程档案 / 001</span><span class="bench-cross" aria-hidden="true">+</span></div>
          <div class="identity">
            <div class="portrait"><img src={site.avatar} alt="榕的二次元头像" width="112" height="112" loading="eager" fetchpriority="high" /></div>
            <div class="identity-copy"><span class="mono">Developer</span><p>{site.name}<span>{site.nameEn}</span></p><span class="identity-role">前端 / 全栈 / 工程化</span></div>
          </div>
          <div class="delivery">
            <div class="delivery-head"><span>交付链路</span><span>技术示意</span></div>
            <ol class="delivery-nodes">
              <li><span class="node-index">01</span><div><b>前端交互</b><span>Vue / React / TypeScript</span></div><span class="node-plus" aria-hidden="true">+</span></li>
              <li><span class="node-index">02</span><div><b>接口服务</b><span>Spring Boot / Redis / MQ</span></div><span class="node-plus" aria-hidden="true">+</span></li>
              <li><span class="node-index">03</span><div><b>构建交付</b><span>Docker / Nginx / CI/CD</span></div><span class="node-plus" aria-hidden="true">↗</span></li>
            </ol>
          </div>
          <div class="bench-footer"><span>理解业务 → 实现 → 交付</span><span class="registration" aria-hidden="true"></span></div>
        </aside>
      </div>
      <div class="hero-foot">
        <dl class="hero-facts"><div><dt>企业级开发</dt><dd>近 4 年</dd></div><div><dt>脱敏项目案例</dt><dd>06</dd></div><div><dt>组件库服务产品线</dt><dd>10+</dd></div></dl>
        <a class="scroll-cue" href="#projects">向下查看作品 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section id="projects" class="work-section" aria-labelledby="projects-title">
    <div class="wrap section-inner">
      <div class="section-head"><div><p class="section-index">01 / Selected work</p><h2 id="projects-title">项目档案<span class="signal-dot" aria-hidden="true"></span></h2></div><p class="section-note">{projects.length} 个公司项目，已脱敏。<br />从实际业务出发，记录方案与取舍。</p></div>
      <div class="filters" role="group" aria-label="按类型筛选项目">
        {categories.map((category) => <button type="button" class:list={['filter', { 'is-active': category.key === 'all' }]} data-filter={category.key} aria-pressed={category.key === 'all' ? 'true' : 'false'}>{category.label}<span>{category.key === 'all' ? projects.length : projects.filter((project) => project.data.category === category.key).length}</span></button>)}
      </div>
      <div class="featured-grid">
        {featured.map((project, index) => (
          <a class="project-card card" href={`/projects/${project.id}/`} data-category={project.data.category}>
            <div class="project-cover"><div class="cover-head"><span class="mono">P / {String(index + 1).padStart(2, '0')}</span><span>技术示意</span></div><ProjectBlueprint kind={project.id} /></div>
            <div class="project-copy"><p class="project-period">{project.data.period}</p><h3>{project.data.name}</h3><p class="project-summary">{summaries[project.id]}</p><div class="project-foot"><span>{project.data.role}</span><span class="project-arrow" aria-hidden="true">↗</span></div></div>
          </a>
        ))}
      </div>
      <div class="archive" aria-label="其他项目">
        {archive.map((project, index) => (
          <a class="archive-row" href={`/projects/${project.id}/`} data-category={project.data.category}><span class="archive-num mono">{String(index + featured.length + 1).padStart(2, '0')}</span><h3>{project.data.name}</h3><span class="archive-summary">{archiveSummaries[project.id]}</span><span class="archive-year mono">{project.data.period.split(' — ')[0]}</span><span class="project-arrow" aria-hidden="true">↗</span></a>
        ))}
      </div>
      <p class="project-boundary">周期为项目参与区间，部分项目并行；个人职责与指标口径见各案例。</p>
      <p class="filter-status visually-hidden" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section id="domain" class="engineering" aria-labelledby="engineering-title" data-moment="word-highlight">
    <div class="wrap section-inner">
      <div class="section-head"><div><p class="section-index">02 / Engineering</p><h2 id="engineering-title">工程能力</h2></div><span class="section-note">物流 / 仓储 / 物资管理</span></div>
      <p class="engineering-statement mo-wh__text">理解业务角色， 理清流程状态，<br />让系统适应 <strong>真实的现场。</strong></p>
      <div class="capability-grid">
        {capabilities.map((capability, index) => <a class="capability" href={capability.href}><span class="capability-index mono">{capability.index}</span><div><h3>{capabilityTitles[index]}</h3><p>{capabilityDetails[index]}</p><span class="capability-proof">{capability.proof}</span></div><span class="project-arrow" aria-hidden="true">↗</span></a>)}
      </div>
      <div class="stack-strip" id="stack"><span class="mono">项目实战</span><p>Vue / React / TypeScript / Java / Spring Boot / Docker</p><a class="m-link" href="/about/#stack">查看技术分层 ↗</a></div>
    </div>
  </section>

  <section id="experience" class="experience-section" aria-labelledby="experience-title">
    <div class="wrap section-inner">
      <div class="section-head"><div><p class="section-index">03 / Experience & beyond</p><h2 id="experience-title">经历与下一步</h2></div><a class="section-link m-link" href="/about/">完整经历 ↗</a></div>
      <div class="experience-grid">
        <div class="experience-list">
          {experience.map((job, index) => <article class="job"><div class="job-meta"><span class="job-time mono">{job.period}</span>{index === 0 && <span class="job-current">现在</span>}</div><h3>{job.role}</h3><p class="job-company">{job.company}</p><p class="job-summary">{job.summary}</p><ul class="job-tags" aria-label="工作关键词">{job.keywords.map((keyword) => <li>{keyword}</li>)}</ul></article>)}
          <div class="education"><span class="mono">Education</span><p><b>{education.school}</b> · {education.major}</p><span class="mono">{education.period}</span></div>
        </div>
        <aside class="lab-panel" id="direction" aria-label="正在学习与探索">
          <div class="lab-heading"><span class="mono">Side projects / Lab</span><span class="lab-mark" aria-hidden="true">↗</span></div>
          <h3>保持好奇，<br />继续动手。</h3>
          <p class="lab-intro">工作之外，关注工业 AI 与企业 AI 应用，把新的想法逐步变成可验证的实验。</p>
          <div class="lab-items">{explorations.map((item) => <div class="lab-item"><span class="lab-status">{item.status}</span><p>{item.title}</p></div>)}</div>
          <p class="lab-boundary">这些方向处于学习或方案阶段，尚未作为生产项目交付。FDE 是长期职业方向。</p>
          <a class="lab-link" href="/lab/">查看技术探索 <span aria-hidden="true">↗</span></a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const projects = document.querySelectorAll<HTMLElement>('[data-category]');
  const status = document.querySelector<HTMLElement>('.filter-status');
  const archive = document.querySelector<HTMLElement>('.archive');
  const featured = document.querySelector<HTMLElement>('.featured-grid');
  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.filter;
      document.querySelector('#projects')?.classList.toggle('is-filtered', key !== 'all');
      filters.forEach((filter) => {
        const active = filter === button;
        filter.classList.toggle('is-active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      let count = 0;
      projects.forEach((project) => {
        const visible = key === 'all' || project.dataset.category === key;
        project.hidden = !visible;
        if (visible) count += 1;
      });
      if (archive) archive.hidden = !Array.from(archive.querySelectorAll<HTMLElement>('[data-category]')).some((project) => !project.hidden);
      if (featured) featured.hidden = !Array.from(featured.querySelectorAll<HTMLElement>('[data-category]')).some((project) => !project.hidden);
      if (status) status.textContent = `显示 ${count} 个项目`;
    });
  });
</script>

<style>
  .mono, .section-index { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .square { display: inline-block; width: 8px; height: 8px; flex: none; background: var(--signal); }
  .hero { min-height: 100svh; }
  .hero-inner { display: flex; min-height: 100svh; flex-direction: column; justify-content: space-between; padding-block: calc(var(--nav) + 32px) 32px; }
  .hero-topline { display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--muted); }
  .hero-topline > span:first-child { display: flex; align-items: center; gap: 12px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; align-items: start; padding-block: 40px; }
  .hero-kicker { margin-bottom: 24px; font-size: 15px; font-weight: 500; }
  .hero h1 { font-size: clamp(48px, 5.1vw, 74px); font-weight: 760; line-height: 1.18; letter-spacing: -0.06em; text-wrap: initial; }
  .title-stop { color: var(--accent); }
  .hero-intro { margin-top: 28px; font-size: 17px; line-height: 1.8; }
  .hero-actions { display: flex; gap: 12px; margin-top: 32px; }
  .hero-status { display: flex; gap: 8px; align-items: center; margin-top: 24px; color: var(--muted); font-size: 13px; }
  .hero-status .square { width: 6px; height: 6px; }
  .workbench { border: 1px solid var(--line-strong); background: var(--paper-raised); }
  .bench-header { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 13px; }
  .bench-cross { color: var(--accent); font-size: 20px; line-height: 1; }
  .identity { display: flex; gap: 24px; align-items: center; padding: 24px; }
  .portrait { flex: none; width: 104px; height: 104px; overflow: hidden; border: 1px solid var(--line-strong); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .identity-copy > .mono { color: var(--muted); font-size: 13px; }
  .identity-copy p { display: flex; align-items: baseline; gap: 12px; margin-top: 4px; font-size: 32px; font-weight: 700; }
  .identity-copy p span { font-size: 17px; letter-spacing: -0.04em; }
  .identity-role { font-size: 13px; color: var(--muted); }
  .delivery { padding: 0 24px 24px; }
  .delivery-head { display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 13px; color: var(--muted); }
  .delivery-nodes { margin: 0; padding: 0; list-style: none; }
  .delivery-nodes li { position: relative; display: flex; align-items: center; gap: 16px; padding-block: 12px; border-top: 1px solid var(--line); }
  .node-index { font-family: var(--font-mono); color: var(--accent); font-size: 13px; }
  .delivery-nodes b { display: block; font-size: 14px; font-weight: 600; }
  .delivery-nodes div > span { display: block; margin-top: 2px; font-family: var(--font-mono); color: var(--muted); font-size: 13px; }
  .node-plus { margin-left: auto; color: var(--accent); }
  .bench-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 24px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .registration { display: block; width: 44px; height: 16px; background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 9px); opacity: .5; }
  .hero-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding-top: 24px; border-top: 1px solid var(--line-strong); }
  .hero-facts { display: flex; gap: 64px; margin: 0; }
  .hero-facts > div { display: flex; flex-direction: column-reverse; gap: 4px; }
  .hero-facts dt { font-size: 13px; color: var(--muted); }
  .hero-facts dd { margin: 0; font-size: 28px; font-weight: 650; letter-spacing: -.05em; line-height: 1.2; }
  .scroll-cue { display: flex; gap: 32px; align-items: center; min-height: 44px; color: var(--muted); font-size: 13px; }
  .scroll-cue span { color: var(--ink); font-size: 24px; }
  .section-inner { display: flex; flex-direction: column; justify-content: center; min-height: 100svh; padding-block: 80px 64px; }
  .section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 32px; }
  .section-index { margin-bottom: 12px; font-size: 13px; color: var(--muted); }
  .section-head h2 { font-size: var(--t-h2); letter-spacing: -.05em; }
  .signal-dot { display: inline-block; width: 10px; height: 10px; margin-left: 12px; background: var(--signal); }
  .section-note { font-size: 14px; color: var(--muted); line-height: 1.7; }
  .work-section { background: var(--paper-raised); }
  .work-section .section-inner { padding-block: 80px 36px; }
  .work-section.is-filtered .section-inner { min-height: auto; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
  .filter { display: inline-flex; gap: 12px; align-items: center; min-height: 44px; padding: 8px 16px; border: 1px solid var(--line); border-radius: 2px; font-size: 14px; transition: background-color 150ms, color 150ms; }
  .filter span { font-family: var(--font-mono); font-size: 13px; }
  .filter:hover { border-color: var(--line-strong); }
  .filter.is-active { border-color: var(--ink); background: var(--ink); color: var(--paper-raised); }
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .project-card { display: flex; min-width: 0; flex-direction: column; border: 1px solid var(--line); border-radius: 2px; background: var(--paper-raised); }
  .project-cover { padding: 12px 20px 0; background: var(--paper); border-bottom: 1px solid var(--line); }
  .cover-head { display: flex; justify-content: space-between; gap: 16px; font-size: 13px; color: var(--muted); }
  .project-copy { flex: 1; display: flex; flex-direction: column; padding: 16px; }
  .project-period { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  .project-copy h3 { margin-top: 8px; font-size: 22px; letter-spacing: -.04em; line-height: 1.4; }
  .project-summary { margin-top: 8px; font-size: 16px; line-height: 1.7; }
  .project-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding-top: 16px; color: var(--muted); font-size: 13px; }
  .project-arrow { display: inline-block; flex: none; color: var(--accent); font-size: 22px; line-height: 1; transition: transform 150ms; }
  a:hover .project-arrow { transform: translate(2px, -2px); }
  .archive { margin-top: 24px; }
  .archive-row { display: grid; grid-template-columns: 24px minmax(200px, 1.2fr) minmax(200px, 1fr) 100px 24px; gap: 16px; align-items: center; min-height: 56px; padding-block: 12px; border-bottom: 1px solid var(--line); transition: color 150ms; }
  .archive-row:hover { color: var(--accent); }
  .archive-num, .archive-year { color: var(--muted); font-size: 13px; }
  .archive-row h3 { font-size: 16px; line-height: 1.6; font-weight: 600; }
  .archive-summary { color: var(--muted); font-size: 14px; }
  .project-boundary { margin-top: 20px; color: var(--muted); font-size: 13px; }
  .engineering { --paper: #191d20; --bg: #191d20; --ink: #f0f2ed; --muted: #b5bdbe; --accent: #ff946d; --line: rgba(240,242,237,.2); --line-strong: rgba(240,242,237,.4); background: var(--paper); color: var(--ink); }
  .engineering-statement { margin-bottom: 40px; font-weight: 650; line-height: 1.35; }
  .capability-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 64px; }
  .capability { display: flex; gap: 20px; padding-block: 24px; border-top: 1px solid var(--line); }
  .capability-index { padding-top: 4px; color: var(--accent); font-size: 13px; }
  .capability h3 { font-size: 22px; line-height: 1.4; }
  .capability p { max-width: 40ch; margin-top: 12px; font-size: 16px; line-height: 1.7; }
  .capability-proof { display: block; margin-top: 16px; font-size: 13px; color: var(--muted); }
  .capability > .project-arrow { margin-left: auto; padding-top: 4px; }
  .stack-strip { display: flex; align-items: center; gap: 24px; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 13px; }
  .stack-strip > span { color: var(--muted); white-space: nowrap; }
  .stack-strip p { font-size: 14px; }
  .stack-strip a { margin-left: auto; flex: none; min-height: 44px; display: inline-flex; align-items: center; }
  .experience-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; }
  .section-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; }
  .job { position: relative; border-top: 1px solid var(--line-strong); padding-block: 24px; }
  .job-meta { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; }
  .job-time { color: var(--muted); font-size: 13px; }
  .job-current { background: var(--signal); color: #191d20; padding: 0 8px; font-size: 13px; }
  .job h3 { font-size: 21px; line-height: 1.4; }
  .job-company { margin-top: 8px; font-size: 14px; color: var(--muted); }
  .job-summary { margin-top: 16px; font-size: 16px; line-height: 1.75; }
  .job-tags { display: flex; gap: 8px 16px; flex-wrap: wrap; list-style: none; padding: 0; margin: 16px 0 0; color: var(--muted); font-size: 13px; }
  .job-tags li::before { content: '/'; margin-right: 8px; color: var(--accent); }
  .education { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding-top: 20px; border-top: 1px solid var(--line-strong); font-size: 14px; }
  .education > span { font-size: 13px; color: var(--muted); }
  .education > span:last-child { display: block; width: 100%; }
  .lab-panel { display: flex; flex-direction: column; padding: 32px; background: var(--paper-raised); border: 1px solid var(--line-strong); }
  .lab-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--muted); font-size: 13px; }
  .lab-mark { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: var(--signal); color: #191d20; font-size: 28px; }
  .lab-panel h3 { margin-top: 32px; font-size: 40px; letter-spacing: -.05em; line-height: 1.25; }
