---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import OssRow from '../components/OssRow.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { site, experience, ossProjects, skillGroups } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = [
  { key: 'all', label: '全部' },
  { key: 'ai', label: 'AI 应用' },
  { key: 'business', label: '业务系统' },
  { key: 'infra', label: '工程基建' },
  { key: 'cross-platform', label: '跨端应用' },
] as const;
const categoryCounts = projects.reduce<Record<string, number>>((acc, project) => {
  acc[project.data.category] = (acc[project.data.category] ?? 0) + 1;
  return acc;
}, {});
const featuredCategories = ['ai', 'business', 'infra', 'cross-platform'] as const;
const featured = featuredCategories
  .map((key) => projects.find((project) => project.data.category === key))
  .filter((project): project is CollectionEntry<'projects'> => Boolean(project));
const categoryLabels = Object.fromEntries(
  categories.filter((category) => category.key !== 'all').map((category) => [category.key, category.label]),
) as Record<string, string>;
---
<BaseLayout>
  <section class="hero">
    <svg
      class="hero-vine"
      viewBox="0 0 300 620"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="xMidYMin meet"
    >
      <path
        d="M210 -20 C 226 70, 178 128, 200 200 C 222 272, 286 300, 268 386 C 252 462, 186 486, 200 640"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"></path>
      <path
        d="M130 -20 C 118 58, 152 96, 136 158"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        opacity="0.55"></path>
    </svg>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1 class="hero-title">
          <span>全栈工程师，</span>
          <span>做界面，也做系统。</span>
        </h1>
        <p class="hero-intro">{site.intro}</p>
        <p class="hero-now">
          <span class="status-dot" aria-hidden="true"></span>
          {site.now}
        </p>
        <div class="hero-actions">
          <a class="btn btn-solid" href="#projects">查看项目</a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}>联系我</a>
        </div>
        <ul class="hero-stats" aria-label="概览">
          <li>
            <strong>3 年</strong>
            <span>开发经验</span>
          </li>
          <li>
            <strong>4 个</strong>
            <span>从 0 到 1 的项目</span>
          </li>
          <li>
            <strong>10+</strong>
            <span>组件库服务的产品线</span>
          </li>
        </ul>
      </div>

      <div class="hero-portrait">
        <img src={site.avatar} alt="榕的头像" width="220" height="220" loading="eager" />
      </div>
    </div>
  </section>

  <section class="feature wrap" aria-labelledby="feature-title">
    <div class="feature-head">
      <div>
        <p class="feature-kicker">案例速览</p>
        <h2 id="feature-title">一条链路，看清一个项目。</h2>
      </div>
      <p class="section-note">按分类切换 · 完整取舍见案例详情</p>
    </div>

    <div class="feature-switch" role="group" aria-label="选择案例分类">
      {featured.map((project, i) => (
        <button
          type="button"
          class:list={['feature-btn', { 'is-active': i === 0 }]}
          data-feature={project.data.category}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {categoryLabels[project.data.category] ?? project.data.category}
        </button>
      ))}
    </div>

    {featured.map((project, i) => (
      <article
        class="feature-panel"
        data-panel={project.data.category}
        hidden={i !== 0}
        aria-label={project.data.name}
      >
        <div class="feature-flow-wrap">
          <p class="feature-flow-label">核心链路</p>
          <div class="feature-flow" aria-label="核心链路">
            {project.data.flow.map((step, stepIndex) => (
              <div class="feature-step">
                <span class="feature-num">{String(stepIndex + 1).padStart(2, '0')}</span>
                <b>{step.name}</b>
                <span class="feature-detail">{step.detail}</span>
              </div>
            ))}
          </div>
          <p class="feature-flow-note">工作项目 · 流程简图</p>
        </div>

        <div class="feature-body">
          <p class="feature-meta">{project.data.period} · 公司项目（已脱敏）</p>
          <h3>{project.data.name}</h3>
          <p class="feature-thesis">{project.data.thesis}</p>
          <p class="feature-summary">{project.data.summary}</p>
          <a class="feature-link" href={`/projects/${project.id}/`}>阅读完整案例</a>
        </div>
      </article>
    ))}
  </section>

  <section id="projects" class="section wrap">
    <div class="section-head">
      <h2>项目</h2>
      <p class="section-note">公司项目 · 内容已脱敏</p>
    </div>
    <div class="filters" role="group" aria-label="按类型筛选项目">
      {categories.map((category) => (
        <button
          type="button"
          class:list={['filter', { 'is-active': category.key === 'all' }]}
          data-filter={category.key}
          aria-pressed={category.key === 'all' ? 'true' : 'false'}
        >
          {category.label}
          <span>{category.key === 'all' ? projects.length : (categoryCounts[category.key] ?? 0)}</span>
        </button>
      ))}
    </div>
    <div class="project-list" id="project-list">
      {projects.map((project) => <ProjectRow project={project} />)}
    </div>
    <p class="filter-empty" hidden>这个分类下还没有项目。</p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>开源与练习</h2>
      <p class="section-note">GitHub 上的早期项目</p>
    </div>
    <div class="oss-list">
      {ossProjects.map((project) => <OssRow project={project} />)}
    </div>
  </section>

  <section id="experience" class="section wrap">
    <div class="section-head">
      <h2>经历</h2>
      <a class="section-link" href="/about/">完整经历</a>
    </div>
    <ul class="timeline">
      {experience.map((job) => (
        <li class="job-row">
          <span class="job-period">{job.period}</span>
          <span class="job-company">{job.company}</span>
          <span class="job-role">{job.role}</span>
          <span class="job-desc">{job.summary}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="stack" class="section wrap">
    <div class="section-head">
      <h2>常用技术与研究工具</h2>
      <p class="section-note">日常开发、工程交付与 AI 研究</p>
    </div>
    <div class="tool-grid">
      {skillGroups.map((group) => (
        <section class="tool-group">
          <h3>{group.group}</h3>
          <p class="tool-note">{group.note}</p>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section id="cooperate" class="section wrap">
    <div class="section-head">
      <h2>合作方式</h2>
      <a class="section-link" href="/services/">查看交付方式</a>
    </div>
    <div class="coop-grid">
      <div class="coop-item">
        <span class="coop-index">01</span>
        <h3>全职现场</h3>
        <p>接受全职 offer，可到岗。方向偏中后台、前端基建与 AI 应用。</p>
      </div>
      <div class="coop-item">
        <span class="coop-index">02</span>
        <h3>远程协作</h3>
        <p>远程全职或长期协作，按周同步，以文档、代码和演示推进。</p>
      </div>
      <div class="coop-item">
        <span class="coop-index">03</span>
        <h3>项目制私活</h3>
        <p>需求明确的页面、系统、组件库或 AI 应用，按阶段交付与验收。</p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="contact">
      <div>
        <h2>聊聊</h2>
        <p class="contact-lead">
          目前接受全职现场、远程协作与项目制合作。如果对我的项目或经历感兴趣，欢迎来信；也欢迎在 GitHub 上交流。
        </p>
      </div>
      <div class="contact-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const projectRows = document.querySelectorAll<HTMLElement>('#project-list [data-category]');
  const emptyState = document.querySelector<HTMLElement>('.filter-empty');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.filter;

      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      let visible = 0;
      projectRows.forEach((row) => {
        const show = key === 'all' || row.dataset.category === key;
        row.hidden = !show;
        if (show) visible += 1;
      });

      if (emptyState) emptyState.hidden = visible > 0;
    });
  });

  const featureButtons = document.querySelectorAll<HTMLButtonElement>('[data-feature]');
  const featurePanels = document.querySelectorAll<HTMLElement>('[data-panel]');

  featureButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.feature;

      featureButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      featurePanels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== key;
      });
    });
  });
</script>

<style>
  /* Hero ---------------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero-vine {
    position: absolute;
    top: -30px;
    right: clamp(1rem, 6vw, 5rem);
    z-index: 0;
    height: calc(100% + 60px);
    width: auto;
    color: var(--accent);
    opacity: 0.42;
    pointer-events: none;
  }

  .hero-vine path {
    stroke-dasharray: 1100;
    stroke-dashoffset: 1100;
    animation: draw 1.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.15s forwards;
  }

  .hero-vine path + path {
    animation-delay: 0.6s;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(4rem, 11vw, 7.5rem);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6.6vw, 4.6rem);
    line-height: 1.04;
  }

  .hero-title span {
    display: block;
  }

  .hero-intro {
    max-width: 46ch;
    margin-top: 1.6rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .hero-now {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .status-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--seal);
    transform: translateY(-1px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.2rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0 clamp(1.4rem, 3.5vw, 2.4rem);
    margin: 2.6rem 0 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero-stats li + li {
    padding-left: clamp(1.2rem, 3vw, 2rem);
    border-left: 1px solid var(--line);
  }

  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .hero-stats span {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  /* Feature case --------------------------------------------------- */
  .feature {
    padding-block: clamp(3rem, 7vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .feature-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin-bottom: 1.4rem;
  }

  .feature-kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .feature-head h2 {
    margin-top: 0.45rem;
    font-size: 1.6rem;
  }

  .feature-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.3rem;
    margin-bottom: 1.1rem;
  }

  .feature-btn {
    position: relative;
    padding: 0.4rem 0;
    color: var(--muted);
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .feature-btn::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1.5px;
    background: transparent;
  }

  .feature-btn:hover {
    color: var(--ink);
  }

  .feature-btn.is-active {
    color: var(--ink);
  }

  .feature-btn.is-active::after {
    background: var(--seal);
  }

  .feature-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.3rem, 3vw, 2.2rem);
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
  }

  .feature-flow-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-flow-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .feature-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    align-content: start;
  }

  .feature-flow-note {
    margin-top: auto;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .feature-step {
    position: relative;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-strong);
  }

  .feature-step + .feature-step::before {
    content: '›';
    position: absolute;
    top: 2.35rem;
    left: -0.62rem;
    color: var(--seal);
    font-size: 0.9rem;
    line-height: 1;
  }

  .feature-num {
    display: block;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .feature-step b {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .feature-detail {
    display: block;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .feature-meta {
    color: var(--muted);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  .feature-body h3 {
    margin-top: 0.45rem;
    font-size: 1.3rem;
  }

  .feature-thesis {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .feature-summary {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .feature-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.86rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .feature-link:hover {
    color: var(--accent);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.68rem 1.35rem;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: 0.92rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn-solid {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-solid:hover {
    background: var(--accent);
  }

  .btn-ghost {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero-portrait {
    position: relative;
    justify-self: end;
  }

  .hero-portrait img {
    width: clamp(150px, 20vw, 220px);
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }

  .hero-portrait::after {
    content: '';
    position: absolute;
    inset: -12px;
    border: 1px dashed var(--line-strong);
    border-radius: 50%;
  }

  /* Sections ------------------------------------------------------ */
  .section {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .section + .section {
    border-top: 1px solid var(--line);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .section-head h2 {
    font-size: 1.6rem;
  }

  .section-note {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .section-link {
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .section-link:hover {
    color: var(--accent);
  }

  /* Project filters ----------------------------------------------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.3rem;
    margin-bottom: 1.2rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .filter {
    position: relative;
    padding: 0.4rem 0;
    color: var(--muted);
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .filter::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.85rem;
    left: 0;
    height: 1.5px;
    background: transparent;
  }

  .filter:hover {
    color: var(--ink);
  }

  .filter.is-active {
    color: var(--ink);
  }

  .filter.is-active::after {
    background: var(--seal);
  }

  .filter span {
    margin-left: 0.3rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .filter-empty {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Timeline ------------------------------------------------------ */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .job-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    padding: 1.1rem 0.9rem;
    margin-inline: -0.9rem;
    border-top: 1px solid var(--line);
  }

  .job-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .job-period {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .job-company {
    font-size: 1rem;
    font-weight: 500;
  }

  .job-role {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .job-desc {
    grid-column: 2 / -1;
    max-width: 58ch;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  /* Tech stack ----------------------------------------------------- */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 2.5rem;
  }

  .tool-group h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .tool-note {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .tool-group ul {
    margin: 0.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .tool-group li {
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
  }

  /* Cooperation ---------------------------------------------------- */
  .coop-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }

  .coop-item {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .coop-index {
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .coop-item h3 {
    margin-top: 0.4rem;
    font-size: 1.08rem;
  }

  .coop-item p {
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  /* Contact ------------------------------------------------------- */
  .contact {
