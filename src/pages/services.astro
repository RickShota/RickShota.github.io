---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const services = [
  {
    title: '中后台与业务系统',
    detail: '数据可视化、工作流、权限中心与运营管理端，从原型到生产交付的完整闭环。',
  },
  {
    title: '组件库与工程化',
    detail: 'Monorepo、组件库、CLI 脚手架、代码规范与 CI/CD，把重复的事收敛成可复用的基建。',
  },
  {
    title: 'AI 应用前端',
    detail: '大模型接入、流式对话、智能分析报告，以及 AI 工具在业务里的实际落地。',
  },
  {
    title: '跨端与移动应用',
    detail: 'uni-app 多端应用、离线作业、扫码与地图能力，覆盖现场作业场景。',
  },
];

const modes = [
  {
    label: '全职现场',
    title: '接受全职 offer',
    detail: '可到岗，方向偏中后台、前端基建与 AI 应用，也接受全栈方向的机会。',
  },
  {
    label: '远程协作',
    title: '远程全职或长期协作',
    detail: '按周同步进度，以文档、代码和演示推进，适合跨城市团队。',
  },
  {
    label: '项目制私活',
    title: '按项目交付',
    detail: '需求明确的页面、系统、组件库或 AI 应用，可按阶段拆分、验收与结算。',
  },
];

const process = [
  { step: '需求沟通', detail: '确认业务目标、现有系统、时间与预算边界。' },
  { step: '方案与报价', detail: '给出范围、技术方案、里程碑与费用。' },
  { step: '开发与演示', detail: '分阶段开发，定期演示，及时调整。' },
  { step: '验收与交接', detail: '源码、文档、部署说明与约定维护期。' },
];
---
<BaseLayout
  title="交付方式"
  description="榕（RickRone）的合作方式：全职现场、远程协作与项目制私活，按阶段交付与验收。"
>
  <article class="services wrap">
    <header class="head">
      <p class="kicker">合作方式</p>
      <h1>全职、远程、私活，<br />都可以先聊清楚。</h1>
      <p class="lead">
        目前接受全职现场、远程协作与项目制合作。先把目标、范围和交付方式说清楚，再决定怎么开始。
      </p>
      <a class="btn" href={`mailto:${site.email}`}>发邮件聊聊</a>
    </header>

    <section class="block">
      <h2>我能做什么</h2>
      <div class="service-grid">
        {services.map((item) => (
          <div class="service">
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block">
      <h2>合作形式</h2>
      <ul class="mode-list">
        {modes.map((mode, index) => (
          <li>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="mode-label">{mode.label}</p>
              <h3>{mode.title}</h3>
              <p class="mode-detail">{mode.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2>交付流程</h2>
      <ol class="process">
        {process.map((item, index) => (
          <li>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <b>{item.step}</b>
            <span class="process-detail">{item.detail}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="block">
      <h2>交付内容</h2>
      <ul class="plain-list">
        <li>可运行的源码与必要的注释，按约定范围交付。</li>
        <li>部署说明、环境配置与接入文档。</li>
        <li>关键模块的设计说明与使用示例。</li>
        <li>约定维护期内的 bug 修复与必要支持。</li>
      </ul>
    </section>

    <section class="block">
      <h2>联系</h2>
      <p class="contact-line">
        邮件：<a href={`mailto:${site.email}`}>{site.email}</a><br />
        GitHub：<a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </p>
      <p class="contact-note">邮件请简单说明项目背景、目标和时间预期，我会尽快回复。</p>
    </section>
  </article>
</BaseLayout>

<style>
  .services {
    max-width: 52rem;
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .head h1 {
    margin-top: 0.8rem;
    font-size: clamp(2rem, 4.8vw, 2.9rem);
    line-height: 1.18;
  }

  .lead {
    max-width: 52ch;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .btn {
    display: inline-flex;
    margin-top: 1.6rem;
    padding: 0.68rem 1.35rem;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.92rem;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background: var(--accent);
  }

  .block {
    margin-top: clamp(2.6rem, 6vw, 3.8rem);
  }

  .block h2 {
    font-size: 1.4rem;
  }

  /* Services ------------------------------------------------------ */
  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem 2rem;
    margin-top: 1.4rem;
  }

  .service h3 {
    font-size: 1.02rem;
  }

  .service p {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  /* Modes --------------------------------------------------------- */
  .mode-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .mode-list li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.2rem 0;
  }

  .num {
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding-top: 0.2em;
  }

  .mode-label {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .mode-list h3 {
    margin-top: 0.2rem;
    font-size: 1.05rem;
  }

  .mode-detail {
    max-width: 56ch;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Process ------------------------------------------------------- */
  .process {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .process .num {
    display: block;
    padding-top: 0;
  }

  .process b {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .process-detail {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  /* Contact ------------------------------------------------------- */
  .plain-list {
    max-width: 60ch;
    margin: 1.2rem 0 0;
    padding-left: 1.2em;
    font-size: 0.94rem;
    line-height: 1.8;
  }

  .plain-list li + li {
    margin-top: 0.35em;
  }

  .contact-line {
    margin-top: 1.2rem;
    font-size: 0.98rem;
    line-height: 1.9;
  }

  .contact-line a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contact-line a:hover {
    color: var(--accent);
  }

  .contact-note {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.86rem;
  }

  @media (max-width: 700px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
