---
import { site } from '../data/site';

const links = [
  { href: '/#projects', label: '项目' },
  { href: '/blog/', label: '文章' },
  { href: '/about/', label: '关于' },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label={`${site.name} ${site.nameEn} 首页`}>
      <span class="brand-name">榕</span>
      <span class="brand-en">{site.nameEn}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a
        class="nav-icon"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub（新窗口打开）"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <button class="theme-toggle nav-icon" type="button" aria-label="切换深浅色主题">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* 隐私模式下忽略 */
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .brand-en {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    font-size: 0.9rem;
  }

  .nav-links a {
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 2px;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav-icon:hover {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .brand-en {
      display: none;
    }

    .nav-links {
      gap: 0.9rem;
      font-size: 0.85rem;
    }
  }
</style>
