---
import { site } from '../data/site';

const links = [
  { href: '/#projects', label: '项目' },
  { href: '/#experience', label: '经历' },
  { href: '/#stack', label: '能力' },
  { href: '/lab/', label: '探索' },
  { href: '/about/', label: '关于' },
  { href: '/resume/', label: '简历' },
  { href: '/services/', label: '合作' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/#projects') return currentPath.startsWith('/projects/');
  const path = href.split('#')[0];
  if (path === '/') return false;
  return currentPath === path || currentPath.startsWith(path);
};
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label={`${site.name} ${site.nameEn} 首页`}>
      <span class="brand-name">榕</span>
      <span class="brand-en">{site.nameEn}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {links.map((link) => (
        <a
          class:list={['nav-link', { 'is-active': isActive(link.href) }]}
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a
        class="nav-icon nav-github"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub（新窗口打开）"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <button class="theme-toggle nav-icon" type="button" aria-label="切换深浅色主题">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
      <button
        class="menu-toggle nav-icon"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg class="icon-menu" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-menu" data-menu hidden>
    <nav class="wrap mobile-nav" aria-label="移动端导航">
      {links.map((link) => (
        <a
          class:list={['mobile-link', { 'is-active': isActive(link.href) }]}
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <div class="mobile-meta">
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* 隐私模式下忽略 */
    }
  });

  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-menu]');

  const setMenu = (open: boolean) => {
    if (!menuToggle || !mobileMenu) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    mobileMenu.toggleAttribute('hidden', !open);
  };

  menuToggle?.addEventListener('click', () => {
    const open = menuToggle.getAttribute('aria-expanded') !== 'true';
    setMenu(open);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('click', (event) => {
    if (menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    const target = event.target as Node;
    if (mobileMenu?.contains(target) || menuToggle?.contains(target)) return;
    setMenu(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    setMenu(false);
    menuToggle.focus();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 720) setMenu(false);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    flex: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .brand-en {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    font-size: 0.9rem;
  }

  .nav-link {
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.is-active {
    color: var(--ink);
  }

  .nav-link.is-active::after {
    content: '';
    display: block;
    height: 1.5px;
    margin-top: 0.12rem;
    background: var(--seal);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    flex: none;
  }

  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 2px;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav-icon:hover {
    color: var(--ink);
  }

  .menu-toggle {
    display: none;
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  .mobile-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper);
    animation: menu-in 0.16s ease-out;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav {
    display: grid;
    padding-block: 0.6rem 1rem;
  }

  .mobile-link {
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 1rem;
  }

  .mobile-link:hover,
  .mobile-link.is-active {
    color: var(--ink);
  }

  .mobile-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .mobile-meta a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 860px) {
    .nav-links {
      gap: 0.8rem;
      font-size: 0.84rem;
    }
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }

    .nav-github {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .brand-en {
      display: none;
    }
  }
</style>
