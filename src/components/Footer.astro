---
import { site } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p>© {year} {site.name} · {site.nameEn}</p>
      <p class="footer-note">深耕 ToB 工业互联网的全栈开发工程师 · 近 4 年企业级系统经验。公司项目内容已脱敏。</p>
    </div>

    <nav class="footer-links" aria-label="页脚导航">
      <a href="/#projects">项目</a>
      <a href="/resume/">简历</a>
      <a href="/lab/">技术探索</a>
      <a href={`mailto:${site.email}`}>邮件</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>

    <p class="footer-note footer-built">
      由 <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> 构建
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 8vw, 5rem);
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding-block: 1.75rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-brand p:first-child {
    color: var(--ink);
  }

  .footer-note {
    margin-top: 0.2rem;
    font-size: 0.78rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }

  .footer-links a,
  .footer-built a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .footer-links a:hover,
  .footer-built a:hover {
    color: var(--accent);
  }

  .footer-built {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .footer-inner {
      gap: 0.7rem;
    }

    .footer-built {
      width: 100%;
    }
  }
</style>
