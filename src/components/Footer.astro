---
import { site } from '../data/site';
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={['footer', { 'closing': home }]} id="contact">
  <div class="wrap footer-wrap">
    {home && (
      <div class="contact-content">
        <p class="contact-index">04 / Contact</p>
        <div class="contact-grid">
          <div><h2>聊聊工作，<br />也聊聊技术<span>。</span></h2><p class="contact-lead">优先寻找 ToB / 工业互联网方向的全职机会，<br />也欢迎远程协作与项目制合作。</p><a class="btn btn--primary" href={`mailto:${site.email}`}>发封邮件 <span aria-hidden="true">↗</span></a></div>
          <div class="contact-details"><div class="contact-line"><span>目标方向</span><p>前端开发 / 全栈开发<br />企业 AI 应用 / 工业软件</p></div><div class="contact-line"><span>来信地址</span><a class="m-link" href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-line"><span>关于我</span><div class="contact-more"><a class="m-link" href="/resume/">查看简历 ↗</a><a class="m-link" href="/services/">合作方式 ↗</a></div></div></div>
        </div>
        <div class="footer-wordmark" aria-hidden="true">RickRone<span>↗</span></div>
      </div>
    )}
    <div class="footer-inner">
      <div class="footer-brand"><p>© {year} {site.name} · {site.nameEn}</p><p class="footer-note">ToB 工业互联网全栈开发 · 公司项目内容已脱敏</p></div>
      <nav class="footer-links" aria-label="页脚导航"><a href="/#projects">项目</a><a href="/resume/">简历</a><a href="/lab/">技术探索</a><a href={`mailto:${site.email}`}>邮件</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
      <p class="footer-built">由 <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> 构建</p>
    </div>
  </div>
</footer>
<style>
  .footer { margin-top: 64px; border-top: 1px solid var(--line-strong); }
  .footer-wrap { padding-block: 24px; }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; color: var(--muted); font-size: 13px; }
  .footer-brand p:first-child { color: var(--ink); font-weight: 500; }
  .footer-note { margin-top: 4px; font-size: 13px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .footer-links a, .footer-built a { display: inline-flex; align-items: center; min-height: 44px; }
  .footer-links a:hover, .footer-built a:hover { color: var(--accent); }
  .footer-built { font-family: var(--font-mono); font-size: 13px; }
  .closing { --paper: #191d20; --bg: #191d20; --ink: #f0f2ed; --muted: #b5bdbe; --accent: #ff946d; --action: #ff946d; --line: rgba(240,242,237,.2); --line-strong: rgba(240,242,237,.4); margin-top: 0; border-top: 0; background: var(--paper); color: var(--ink); }
  .closing .footer-wrap { display: flex; min-height: 100svh; flex-direction: column; justify-content: space-between; padding-block: 88px 72px; }
  .contact-index { font-family: var(--font-mono); color: var(--muted); font-size: 13px; }
  .contact-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; margin-top: 40px; }
  .contact-grid > div:first-child { grid-column: span 7; }
  .contact-details { grid-column: span 5; }
  .contact-grid h2 { font-size: clamp(44px, 5.2vw, 72px); line-height: 1.25; font-weight: 700; letter-spacing: -.06em; }
  .contact-grid h2 > span { color: var(--signal); }
  .contact-lead { margin-top: 24px; font-size: 17px; line-height: 1.8; }
  .contact-grid .btn { margin-top: 32px; }
  .contact-details { padding-top: 8px; }
  .contact-line { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 24px; padding-block: 20px; border-top: 1px solid var(--line); font-size: 16px; line-height: 1.8; }
  .contact-line > span { color: var(--muted); font-size: 13px; }
  .contact-line a { display: inline-flex; align-items: center; min-height: 44px; width: fit-content; }
  .contact-more { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .contact-more a { min-height: 44px; display: inline-flex; align-items: center; }
  .footer-wordmark { display: flex; justify-content: space-between; align-items: center; margin-top: 44px; font-family: var(--font-display); font-size: clamp(80px, 11.1vw, 160px); font-weight: 750; letter-spacing: -.075em; line-height: 1; color: #b5bdbe; }
  .footer-wordmark > span { font-size: .6em; color: var(--signal); }
  .closing .footer-inner { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line); }
  @media (max-width: 1023px) {
    .contact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .contact-grid > div:first-child, .contact-details { grid-column: auto; }
    .contact-line { grid-template-columns: 1fr; gap: 4px; }
    .contact-lead { font-size: 16px; }
    .footer-wordmark { margin-top: 64px; }
  }
  @media (max-width: 767px) {
    .footer { margin-top: 48px; }
    .closing { margin-top: 0; }
    .closing .footer-wrap { min-height: auto; padding-block: 64px 24px; }
    .contact-index { font-size: 13px; }
    .contact-grid { grid-template-columns: 1fr; gap: 40px; margin-top: 32px; }
    .contact-grid h2 { font-size: clamp(36px, 10.4vw, 64px); }
    .contact-lead { margin-top: 20px; font-size: 15px; }
    .contact-lead br { display: none; }
    .contact-grid .btn { width: 100%; }
    .contact-line { grid-template-columns: 68px minmax(0, 1fr); gap: 16px; padding-block: 16px; font-size: 15px; }
    .contact-line > span { font-size: 13px; }
    .footer-wordmark { margin-top: 40px; font-size: 16vw; }
    .footer-inner { gap: 16px; }
    .footer-links { width: 100%; gap: 8px 20px; }
    .footer-note { font-size: 13px; }
    .footer-built { width: 100%; }
    .closing .footer-inner { margin-top: 24px; }
  }
</style>
