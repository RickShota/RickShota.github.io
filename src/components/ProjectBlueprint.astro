---
import type { Lang } from '../i18n';

interface Props { kind: string; lang?: Lang; }
const { kind, lang = 'zh' } = Astro.props;

const copy = {
  zh: {
    label: kind === 'smart-warehouse' ? '扫码、本地缓存与增量同步的技术链路' : kind === 'ai-platform' ? '业务入口通过统一服务接入模型与异步日志' : '组件源码经过测试与文档体系发布给产品线',
    scan: '扫码作业',
    cache: '本地缓存',
    sync: '增量同步',
    chat: '对话',
    generate: '生成',
    vector: '向量',
    service: '统一服务',
    model: '模型 API',
    logs: '异步日志',
    components: '组件 / 测试 / 文档',
    products: '产品线',
  },
  en: {
    label: kind === 'smart-warehouse' ? 'Scanning, local cache and incremental sync pipeline' : kind === 'ai-platform' ? 'Business entry points reach models and async logs through one service layer' : 'Component source published to product lines through testing and docs',
    scan: 'Scan',
    cache: 'Local cache',
    sync: 'Incremental sync',
    chat: 'Chat',
    generate: 'Generate',
    vector: 'Vector',
    service: 'Unified service',
    model: 'Model API',
    logs: 'Async logs',
    components: 'Components / tests / docs',
    products: 'Product lines',
  },
}[lang];
---
<div class:list={['blueprint', { 'blueprint-warehouse': kind === 'smart-warehouse', 'blueprint-ai': kind === 'ai-platform', 'blueprint-components': kind === 'aui-components' }]} aria-label={copy.label} role="img">
  {kind === 'smart-warehouse' ? (
    <>
      <div class="warehouse-node">
        <span class="node-symbol scanner" aria-hidden="true"><span class="scan-bars"></span></span>
        <span class="node-label">{copy.scan}</span>
      </div>
      <span class="connector" aria-hidden="true"></span>
      <div class="warehouse-node">
        <span class="node-symbol" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M11 12h26v8H11zM11 20v8h26v-8M11 28v8h26v-8M16 16h2m-2 8h2m-2 8h2" /></svg>
        </span>
        <span class="node-label">{copy.cache}</span>
      </div>
      <span class="connector connector-last" aria-hidden="true"></span>
      <div class="warehouse-node">
        <span class="node-symbol sync-symbol" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M10 18h28m-7-7 7 7-7 7M38 30H10m7-7-7 7 7 7" /></svg>
        </span>
        <span class="node-label">{copy.sync}</span>
      </div>
    </>
  ) : kind === 'ai-platform' ? (
    <>
      <div class="inputs"><span>{copy.chat}</span><span>{copy.generate}</span><span>{copy.vector}</span></div>
      <span class="connector" aria-hidden="true"></span>
      <div class="service"><span class="service-symbol" aria-hidden="true">{'{ }'}</span><span>{copy.service}</span></div>
      <span class="connector connector-last" aria-hidden="true"></span>
      <div class="outputs"><span>{copy.model}</span><span>{copy.logs}</span></div>
    </>
  ) : (
    <>
      <div class="component-system">
        <div class="packages" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div class="component-center"><b>AUI</b><span>{copy.components}</span></div>
      </div>
      <span class="connector" aria-hidden="true"></span>
      <div class="products"><span>{copy.products}</span><b>10<span>+</span></b></div>
    </>
  )}
</div>

<style>
  .blueprint {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20px minmax(0, 1.15fr) 20px minmax(0, 1fr);
    align-items: center;
    min-height: 144px;
    padding-block: 20px;
    color: var(--ink);
    font-size: var(--text-meta);
    line-height: 1.5;
  }

  .connector { position: relative; height: 1px; background: var(--line-strong); }
  .connector::before { content: ''; position: absolute; right: 0; top: -2px; width: 5px; height: 5px; background: var(--accent); }
  .connector::after { content: ''; position: absolute; inset: -1px 0; background: var(--accent); transform: scaleX(0); transform-origin: left; opacity: 0; }
  .connector-last { --route-delay: 80ms; }
  .warehouse-node { display: flex; min-width: 0; flex-direction: column; align-items: center; gap: 12px; }
  .node-symbol { display: flex; width: 52px; height: 52px; align-items: center; justify-content: center; border: 1px solid var(--line-strong); background: var(--paper-raised); color: var(--accent); }
  .node-symbol svg { width: 42px; height: 42px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: square; stroke-linejoin: miter; }
  .scanner { position: relative; border-color: var(--accent-line); }
  .scanner::after { content: ''; position: absolute; inset: 25px 5px auto; height: 2px; background: var(--signal); }
  .scan-bars { width: 30px; height: 28px; color: var(--ink); background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 9px); }
  .node-label { min-height: 3em; max-width: 11ch; text-align: center; }
  .blueprint-warehouse .connector { align-self: start; margin-top: 26px; }
  .sync-symbol { border-color: var(--accent-line); background: var(--accent-soft); }

  .inputs, .outputs { display: grid; gap: 8px; }
  .inputs span, .outputs span { display: flex; min-height: 28px; align-items: center; justify-content: center; padding: 3px 4px; border: 1px solid var(--line-strong); background: var(--paper-raised); text-align: center; overflow-wrap: anywhere; }
  .service { display: flex; min-height: 96px; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 12px 4px; border: 1px solid var(--accent-line); background: var(--accent-soft); text-align: center; }
  .service-symbol { color: var(--accent); font-family: var(--font-mono); font-size: 32px; line-height: 1; letter-spacing: -.12em; padding-right: .12em; }

  .blueprint-components { grid-template-columns: minmax(0, 1fr) 24px minmax(64px, .5fr); }
  .component-system { display: flex; min-width: 0; align-items: center; gap: 14px; }
  .packages { display: grid; flex: none; grid-template-columns: repeat(2, 22px); gap: 5px; }
  .packages span { width: 22px; height: 22px; border: 1px solid var(--line-strong); background: var(--paper-raised); }
  .packages span:first-child { border-color: var(--signal); background: var(--signal); }
  .component-center { display: flex; min-width: 0; flex-direction: column; gap: 4px; }
  .component-center b { font-size: 40px; letter-spacing: -.06em; font-weight: 750; line-height: 1.1; }
  .component-center > span { color: var(--muted); line-height: 1.6; }
  .products { display: flex; min-height: 96px; flex-direction: column; align-items: center; justify-content: center; padding: 8px 4px; border: 1px solid var(--accent-line); background: var(--accent-soft); text-align: center; }
  .products > b { color: var(--accent); font-family: var(--font-mono); font-size: 28px; font-weight: 500; line-height: 1.4; }
  .products b span { font-size: 18px; vertical-align: top; }

  /* A finite signal answers hover or keyboard focus; the diagram is complete at rest. */
  @keyframes route-once {
    0% { transform: scaleX(0); opacity: 0; }
    25% { opacity: 1; }
    75% { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }
  @keyframes scan-once {
    0%, 100% { transform: translateY(0); }
    45% { transform: translateY(9px); }
    75% { transform: translateY(-9px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.project-card:focus-visible) .connector::after { animation: route-once 220ms ease-out var(--route-delay, 0ms) 1 both; }
    :global(.project-card:focus-visible) .scanner::after { animation: scan-once 240ms ease-out 1; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(.project-card:hover) .connector::after { animation: route-once 220ms ease-out var(--route-delay, 0ms) 1 both; }
    :global(.project-card:hover) .scanner::after { animation: scan-once 240ms ease-out 1; }
  }
  @media (max-width: 1199px) {
    .blueprint { grid-template-columns: minmax(0, 1fr) 12px minmax(0, 1.15fr) 12px minmax(0, 1fr); }
    .blueprint-components { grid-template-columns: minmax(0, 1fr) 16px minmax(60px, .5fr); }
    .component-system { gap: 10px; }
    .packages { grid-template-columns: repeat(2, 18px); gap: 4px; }
    .packages span { width: 18px; height: 18px; }
    .component-center b { font-size: 36px; }
  }
  @media (max-width: 767px) {
    .blueprint { min-height: 176px; }
  }
</style>
