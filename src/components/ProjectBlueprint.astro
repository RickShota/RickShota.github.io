---
interface Props { kind: string; }
const { kind } = Astro.props;
---
<div class:list={['blueprint', { 'blueprint-warehouse': kind === 'smart-warehouse', 'blueprint-ai': kind === 'ai-platform', 'blueprint-components': kind === 'aui-components' }]} aria-label={kind === 'smart-warehouse' ? '扫码、本地缓存与增量同步的技术链路' : kind === 'ai-platform' ? '业务入口通过统一服务接入模型与异步日志' : '组件源码经过测试与文档体系发布给产品线'} role="img">
  {kind === 'smart-warehouse' ? <><div class="scan"><span class="scan-bars" aria-hidden="true"></span><span>扫码作业</span></div><span class="connector" aria-hidden="true"></span><div class="module"><span class="module-mark" aria-hidden="true">↳</span><span>本地缓存</span></div><span class="connector" aria-hidden="true"></span><div class="module module-end"><span class="module-mark" aria-hidden="true">⇄</span><span>增量同步</span></div></> : kind === 'ai-platform' ? <><div class="inputs"><span>对话</span><span>生成</span><span>向量</span></div><span class="connector" aria-hidden="true"></span><div class="service"><span class="service-symbol" aria-hidden="true">{'{ }'}</span><span>统一服务</span></div><span class="connector" aria-hidden="true"></span><div class="outputs"><span>模型 API</span><span>异步日志</span></div></> : <><div class="packages" aria-hidden="true"><span></span><span></span><span></span><span></span></div><div class="component-center"><b>AUI</b><span>组件 / 测试 / 文档</span></div><span class="connector" aria-hidden="true"></span><div class="products"><span>产品线</span><span>10+</span></div></>}
</div>
<style>
  .blueprint { display: flex; align-items: center; justify-content: center; min-height: 112px; gap: 0; padding-block: 16px; font-size: 13px; font-family: var(--font-mono); color: var(--ink); }
  .connector { flex: 1; min-width: 12px; max-width: 28px; height: 1px; background: var(--line-strong); position: relative; }
  .connector::after { content: ''; position: absolute; right: 0; top: -2px; width: 5px; height: 5px; background: var(--accent); }
  .scan, .module { display: flex; flex: none; min-width: 70px; flex-direction: column; align-items: center; gap: 12px; }
  .scan-bars { display: block; width: 42px; height: 32px; background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px); }
  .module-mark { font-size: 28px; color: var(--accent); line-height: 32px; }
  .module-end .module-mark { border: 1px solid var(--line-strong); font-size: 23px; width: 36px; text-align: center; }
  .inputs, .outputs { display: flex; flex: none; flex-direction: column; gap: 5px; }
  .inputs span, .outputs span { display: block; min-width: 56px; padding: 2px 8px; border: 1px solid var(--line-strong); background: var(--paper-raised); text-align: center; }
  .service { display: flex; min-width: 92px; flex-direction: column; align-items: center; gap: 4px; padding: 12px 8px; border: 1px solid var(--accent); background: var(--paper-raised); }
  .service-symbol { color: var(--accent); font-size: 24px; line-height: 1; }
  .packages { display: grid; grid-template-columns: repeat(2, 22px); gap: 5px; margin-right: 12px; }
  .packages span { width: 22px; height: 22px; border: 1px solid var(--line-strong); background: var(--paper-raised); }
  .packages span:first-child { border-color: var(--signal); background: var(--signal); }
  .component-center { display: flex; flex-direction: column; gap: 4px; }
  .component-center b { font-size: 34px; letter-spacing: -.06em; font-weight: 650; line-height: 1.2; }
  .component-center > span { font-size: 13px; color: var(--muted); }
  .products { display: flex; flex-direction: column; align-items: center; padding: 8px 12px; border: 1px solid var(--line-strong); }
  .products span:last-child { font-size: 24px; line-height: 1.3; color: var(--accent); }
  @media (max-width: 1199px) { .blueprint { font-size: 13px; } .scan, .module { min-width: 60px; } .service { min-width: 76px; } .inputs span, .outputs span { min-width: 48px; padding-inline: 6px; } .component-center > span { font-size: 13px; } }
  @media (max-width: 767px) { .packages { grid-template-columns: repeat(2, 18px); gap: 4px; margin-right: 8px; } .packages span { width: 18px; height: 18px; } .blueprint { min-height: 148px; font-size: 13px; } .scan, .module { min-width: 70px; } .component-center > span { font-size: 13px; } }
</style>
