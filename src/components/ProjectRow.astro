---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, period, role, summary, stack, metrics, category } = project.data;

const categoryLabels: Record<string, string> = {
  ai: 'AI 应用',
  business: '业务系统',
  infra: '工程基建',
  'cross-platform': '跨端应用',
};
---
<a class="project" href={`/projects/${project.id}/`} data-category={category}>
  <div class="project-body">
    <div class="project-meta">
      <span class="category">{categoryLabels[category] ?? category}</span>
      <span class="period">{period}</span>
    </div>
    <h3>{name}</h3>
    <p class="role"><span>角色</span>{role}</p>
    <p class="summary">{summary}</p>
    {metrics.length > 0 && (
      <ul class="metrics" aria-label="成果">
        {metrics.map((metric) => <li>{metric}</li>)}
      </ul>
    )}
  </div>
  <div class="project-side">
    <ul class="stack" aria-label="技术栈">
      {stack.slice(0, 4).map((item) => <li>{item}</li>)}
      {stack.length > 4 && <li>+{stack.length - 4}</li>}
    </ul>
    <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </div>
</a>

<style>
  .project {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 2rem;
    align-items: center;
    padding: 1.4rem 0.9rem;
    margin-inline: -0.9rem;
    border-top: 1px solid var(--line);
  }

  .project::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper-raised);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .project:hover::before {
    opacity: 1;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.8rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .category {
    padding: 0.02em 0.42em;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--accent);
    line-height: 1.6;
  }

  .project h3 {
    margin-top: 0.4rem;
    font-size: 1.28rem;
  }

  .role {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .role span {
    margin-right: 0.4rem;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .summary {
    max-width: 58ch;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.7;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .metrics li {
    position: relative;
    padding-left: 0.85rem;
    color: var(--ink);
    font-size: 0.78rem;
  }

  .metrics li::before {
    content: '';
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 6px;
    height: 1.5px;
    background: var(--seal);
  }

  .project-side {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    max-width: 16rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.08em 0.5em;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.7;
    white-space: nowrap;
  }

  .arrow {
    flex: none;
    color: var(--muted);
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }

  .project:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .project {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .project-side {
      justify-content: space-between;
    }

    .stack {
      justify-content: flex-start;
      max-width: none;
    }
  }
</style>
