---
interface Props {
  project: {
    name: string;
    title: string;
    description: string;
    stack: string[];
    url: string;
  };
}

const { project } = Astro.props;
---
<a class="project" href={project.url} target="_blank" rel="noopener noreferrer">
  <div class="project-body">
    <h3>
      {project.name}
      <span class="project-title">{project.title}</span>
    </h3>
    <p>{project.description}</p>
  </div>
  <div class="project-side">
    <ul class="stack" aria-label="技术栈">
      {project.stack.map((item) => <li>{item}</li>)}
    </ul>
    <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </div>
</a>

<style>
  .project {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 2rem;
    align-items: center;
    padding: 1.45rem 0.9rem;
    margin-inline: -0.9rem;
    border-top: 1px solid var(--line);
  }

  .project:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper-raised);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .project:hover::before {
    opacity: 1;
  }

  .project h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.3rem;
  }

  .project-title {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }

  .project p {
    max-width: 54ch;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .project-side {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.08em 0.5em;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.7;
    white-space: nowrap;
  }

  .arrow {
    flex: none;
    color: var(--muted);
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }

  .project:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .project {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .project-side {
      justify-content: space-between;
    }

    .stack {
      justify-content: flex-start;
    }
  }
</style>
