---
interface Props {
  project: {
    name: string;
    description: string;
    stack: string;
    url: string;
  };
}

const { project } = Astro.props;
---
<a class="oss" href={project.url} target="_blank" rel="noopener noreferrer">
  <span class="oss-name">{project.name}</span>
  <span class="oss-desc">{project.description}</span>
  <span class="oss-stack">{project.stack}</span>
  <svg class="arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 17 17 7M9 7h8v8"></path>
  </svg>
</a>

<style>
  .oss {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) auto auto;
    gap: 0.5rem 1.2rem;
    align-items: baseline;
    padding: 0.9rem 0.9rem;
    margin-inline: -0.9rem;
    border-top: 1px solid var(--line);
    transition: background-color 0.2s ease;
  }

  .oss:last-child {
    border-bottom: 1px solid var(--line);
  }

  .oss:hover {
    background: var(--paper-raised);
  }

  .oss-name {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .oss-desc {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .oss-stack {
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .arrow {
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .oss:hover .arrow {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .oss {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.2rem 1rem;
    }

    .oss-desc {
      grid-column: 1 / -1;
    }

    .oss-stack {
      grid-column: 1;
    }

    .arrow {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
    }
  }
</style>
