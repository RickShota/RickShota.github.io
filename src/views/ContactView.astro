---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../data';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const { site } = getContent(lang);

const copy = {
  zh: {
    title: '联系我',
    description: '通过邮件或微信联系榕（RickRone），交流 ToB 工业互联网、全栈开发与企业 AI 应用，洽谈全职机会、远程协作和项目合作。',
    kicker: 'CONTACT / 交流与合作',
    heading: '聊聊工作，',
    headingBreak: '也聊聊技术。',
    lead: '全职机会、远程协作，或是一个值得动手的项目，都可以从这里开始。',
    email: '发封邮件',
    github: '逛逛 GitHub',
    githubAria: '访问 RickRone 的 GitHub（新窗口打开）',
    focusLabel: '关注方向',
    focus: ['ToB 工业互联网', '全栈开发', '企业 AI 应用'],
    wechat: '微信联系',
    wechatNote: '扫码添加好友，请备注来意。',
    qrAlt: '榕（RickRone）的微信联系二维码',
    qrLink: '打开二维码原图',
    qrAria: '在新窗口打开微信二维码原图，可保存后在微信中识别',
  },
  en: {
    title: 'Contact',
    description: 'Contact RickRone by email or WeChat to discuss industrial software, full-stack development, enterprise AI, full-time roles and project collaboration.',
    kicker: 'CONTACT / LET’S TALK',
    heading: 'Let’s talk work',
    headingBreak: 'and technology.',
    lead: 'A full-time role, remote collaboration, or a project worth building — it can start with a conversation.',
    email: 'Send an email',
    github: 'Visit GitHub',
    githubAria: 'Visit RickRone on GitHub (opens in a new tab)',
    focusLabel: 'Focus',
    focus: ['Industrial software', 'Full-stack development', 'Enterprise AI'],
    wechat: 'Connect on WeChat',
    wechatNote: 'Scan to add me and include a short introduction.',
    qrAlt: 'WeChat contact QR code for RickRone',
    qrLink: 'Open full-size QR code',
    qrAria: 'Open the full-size WeChat QR code in a new tab to save or scan it',
  },
}[lang];
---
<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <section class="contact-page" aria-labelledby="contact-title">
    <div class="wrap contact-layout">
      <div class="contact-copy">
        <p class="contact-kicker"><span aria-hidden="true"></span>{copy.kicker}</p>
        <h1 id="contact-title">{copy.heading}<br /><span>{copy.headingBreak}</span></h1>
        <p class="contact-intro">{copy.lead}</p>
        <div class="contact-actions">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>
            {copy.email}<span aria-hidden="true"><Icon name="arrow-up-right" /></span>
          </a>
          <a class="github-link m-link" href={site.github} target="_blank" rel="noopener noreferrer" aria-label={copy.githubAria}>
            {copy.github}<Icon name="arrow-up-right" />
          </a>
        </div>
        <a class="email-address" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="contact-focus">
          <span>{copy.focusLabel}</span>
          <ul>{copy.focus.map((focus) => <li>{focus}</li>)}</ul>
        </div>
      </div>

      <aside class="wechat-card" aria-labelledby="wechat-title">
        <div class="wechat-heading">
          <span class="wechat-index">02 / WECHAT</span>
          <h2 id="wechat-title">{copy.wechat}</h2>
          <p>{copy.wechatNote}</p>
        </div>
        <a class="qr-image" href="/images/wx_QR.jpeg" target="_blank" rel="noopener noreferrer" aria-label={copy.qrAria}>
          <img src="/images/wx_QR.jpeg" alt={copy.qrAlt} width="888" height="1131" decoding="async" />
        </a>
        <a class="qr-original" href="/images/wx_QR.jpeg" target="_blank" rel="noopener noreferrer" aria-label={copy.qrAria}>
          {copy.qrLink}<Icon name="arrow-up-right" />
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page { padding-block: clamp(48px, 6vw, 48px); }
  .contact-layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; gap: clamp(48px, 6vw, 88px); }
  .contact-copy { min-width: 0; }
  .contact-kicker { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; color: var(--muted); font-family: var(--font-mono); font-size: var(--text-meta); letter-spacing: .04em; }
  .contact-kicker > span { width: 8px; height: 8px; flex: none; background: var(--signal); }
  h1 { font-size: clamp(44px, 4.8vw, 72px); font-weight: 760; line-height: 1.2; letter-spacing: -.05em; }
  h1 > span { color: var(--accent); }
  .contact-intro { max-width: 42ch; margin-top: 28px; font-size: 17px; line-height: 1.85; }
  .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 28px; margin-top: 32px; }
  .github-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: var(--text-note); }
  .github-link:is(:hover, :focus-visible) { color: var(--accent); }
  .email-address { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; color: var(--muted); font-size: var(--text-note); overflow-wrap: anywhere; }
  .email-address:is(:hover, :focus-visible) { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .contact-focus { display: flex; align-items: baseline; gap: 20px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); }
  .contact-focus > span { flex: none; color: var(--muted); font-size: var(--text-meta); }
  .contact-focus ul { display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 0; margin: 0; list-style: none; font-size: var(--text-note); }
  .contact-focus li + li::before { content: '/'; margin-right: 16px; color: var(--accent); }
  .wechat-card { position: relative; width: min(100%, 360px); min-width: 0; justify-self: end; padding: 24px; border: 1px solid var(--line-strong); background: var(--paper-raised); box-shadow: var(--surface-shadow); }
  .wechat-card::before { content: ''; position: absolute; top: -1px; left: 24px; width: 40px; height: 2px; background: var(--signal); }
  .wechat-index { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-meta); letter-spacing: .04em; }
  .wechat-heading h2 { margin-top: 12px; font-size: 24px; line-height: 1.4; }
  .wechat-heading p { margin-top: 8px; color: var(--muted); font-size: var(--text-note); line-height: 1.7; }
  .qr-image { display: block; margin-top: 20px; background: #fff; }
  .qr-image img { width: 100%; height: auto; }
  .qr-original { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 44px; margin-top: 8px; color: var(--accent); font-size: var(--text-note); }
  .qr-original:is(:hover, :focus-visible) { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1023px) {
    .contact-layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 32px; }
    h1 { font-size: clamp(36px, 5vw, 52px); }
    .wechat-card { padding: 20px; }
    .contact-focus { flex-direction: column; gap: 12px; }
  }
  @media (max-width: 767px) {
    .contact-page { padding-block: 40px 16px; }
    .contact-layout { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .contact-kicker { margin-bottom: 24px; }
    h1 { font-size: clamp(34px, 9vw, 52px); }
    .contact-intro { margin-top: 24px; font-size: var(--text-body); }
    .contact-actions { gap: 12px 24px; margin-top: 24px; }
    .contact-focus { margin-top: 24px; }
    .contact-focus ul { gap: 8px 16px; }
    .contact-focus li + li::before { margin-right: 12px; }
    .wechat-card { justify-self: center; }
  }
</style>
