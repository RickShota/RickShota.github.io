---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../data';
import { localePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const { site, jobTargets, industry, careerDirection } = getContent(lang);

const copy = {
  zh: {
    title: '求职与合作',
    description:
      '榕（RickRone）寻找 ToB / 工业互联网方向的全栈、前端与 AI 应用岗位，也接受远程协作与项目制合作。',
    kicker: '求职与合作',
    heading: '优先寻找全职机会，',
    headingBreak: '也接受远程与项目制合作。',
    lead: '主要方向是 ToB / 工业互联网的全栈开发（前端为主）、前端开发与企业 AI 应用；Java / Spring Boot 已在 AI 中台项目中落地，工业 AI / FDE 是长期方向。如果你在招聘相关岗位，欢迎直接发岗位说明，我会按项目证据说明能承担的部分。',
    sendEmail: '发送岗位或约聊',
    viewResume: '查看简历',
    targetTitle: '求职意向',
    targetRoles: '目标岗位',
    location: '地点',
    locationValue: '安徽 · 可到岗',
    status: '状态',
    statusValue: '在职，具体到岗时间面谈',
    priority: '优先',
    priorityValue: '全职现场 / 远程全职',
    intentNote:
      '全职是首选。远程协作与项目制合作保留为次要选项，不代表本站以承接外包为主。',
    industryTitle: '行业背景',
    industryTagsAria: '行业场景',
    directionTitle: '技术扩展与职业方向',
    directionTagsAria: '技术扩展方向',
    servicesTitle: '我能带来什么',
    services: [
      {
        title: '复杂 B 端与工业业务系统',
        detail:
          '物流、仓储、物资管理等业务系统，以及数据可视化、工作流、权限中心与运营管理端；能在业务不停摆的前提下做迁移与重构，覆盖从原型到生产交付的闭环。',
      },
      {
        title: '前端工程化与组件基建',
        detail: 'Monorepo、组件库、CLI 脚手架、代码规范、测试与 CI/CD，把重复的事收敛成可复用的团队基建。',
      },
      {
        title: 'Java 后端与全栈交付',
        detail:
          'Spring Boot 接口、MyBatis-Plus 持久化、Redis 缓存、RabbitMQ 异步链路、Spring Security + JWT / RBAC 权限，以及前后端 Docker 容器化部署。',
      },
      {
        title: 'AI 应用接入',
        detail: '大模型 API 集成、SSE 流式对话、上下文与用量管理、智能分析报告；关注 AI 能力在业务里的实际落地。',
      },
      {
        title: '跨端与现场作业',
        detail: 'uni-app 多端应用、扫码、离线同步、地图追踪与弱网适配，覆盖仓库、物流等现场作业场景。',
      },
    ],
    modesTitle: '其他合作方式',
    modesNote: '以下为次要合作方式；如果你主要招聘全职，可以跳过这一节。',
    modes: [
      {
        label: '次要 · 远程',
        title: '远程协作',
        detail: '远程全职或长期协作，按周同步进度，以文档、代码和演示推进，适合跨城市团队。',
      },
      {
        label: '次要 · 项目制',
        title: '项目制合作',
        detail: '需求明确的页面、系统、组件库或 AI 应用，按阶段拆分、验收与结算。',
      },
    ],
    processSummary: '项目制合作流程（次要）',
    processSteps: [
      { step: '需求沟通', detail: '确认业务目标、现有系统、范围与时间边界。' },
      { step: '方案与报价', detail: '给出范围、技术方案、里程碑与费用。' },
      { step: '开发与演示', detail: '分阶段开发，定期演示，及时调整。' },
      { step: '验收与交接', detail: '源码、文档、部署说明与约定维护期。' },
    ],
    processNote:
      '按阶段拆分、验收与结算；范围、源码与维护期以书面约定为准。所有合作都按真实范围说明，不承诺无法验证的指标。',
    contactTitle: '联系',
    contactNote: '邮件请简单说明岗位、团队方向与时间预期，我会尽快回复。',
    emailLabel: '邮件：',
    resumeLabel: '简历：',
    resumeLink: '网页版简历',
  },
  en: {
    title: 'Work with me',
    description:
      'RickRone is looking for full-stack, front-end and AI application roles in ToB / industrial internet, and is open to remote collaboration and project-based work.',
    kicker: 'Work with me',
    heading: 'Full-time roles first,',
    headingBreak: 'open to remote and project work.',
    lead: 'My main focus is full-stack development (front-end first), front-end engineering and enterprise AI in ToB / industrial internet. Java / Spring Boot is already in production on the AI platform; industrial AI / FDE is the long-term direction. If you are hiring, send the job description and I will map my project evidence to what I can own.',
    sendEmail: 'Send a role or say hello',
    viewResume: 'View resume',
    targetTitle: 'Target roles',
    targetRoles: 'Roles',
    location: 'Location',
    locationValue: 'Anhui, China · available to start',
    status: 'Status',
    statusValue: 'Employed; start date to be discussed',
    priority: 'Priority',
    priorityValue: 'Full-time on-site / remote full-time',
    intentNote:
      'Full-time is the first choice. Remote collaboration and project-based work are secondary options; this site is not primarily an outsourcing portfolio.',
    industryTitle: 'Industry background',
    industryTagsAria: 'Industry scenarios',
    directionTitle: 'Technical breadth and career direction',
    directionTagsAria: 'Technical directions',
    servicesTitle: 'What I bring',
    services: [
      {
        title: 'Complex B2B and industrial systems',
        detail:
          'Business systems for logistics, warehousing and materials management, plus data visualization, workflows, permission centers and operations consoles; migrations and refactors that never stop the business, from prototype to production.',
      },
      {
        title: 'Front-end engineering and component infrastructure',
        detail: 'Monorepo, component libraries, CLI scaffolding, code standards, testing and CI/CD, turning repeated work into reusable team infrastructure.',
      },
      {
        title: 'Java back end and full-stack delivery',
        detail:
          'Spring Boot APIs, MyBatis-Plus persistence, Redis caching, RabbitMQ async pipelines, Spring Security + JWT / RBAC, and containerized deployment for both ends.',
      },
      {
        title: 'AI application integration',
        detail: 'LLM API integration, SSE streaming conversation, context and usage management, intelligent analysis reports; focused on real business adoption.',
      },
      {
        title: 'Cross-platform and field operations',
        detail: 'uni-app multi-platform apps, scanning, offline sync, map tracking and weak-network adaptation for warehouse and logistics field work.',
      },
    ],
    modesTitle: 'Other ways to work',
    modesNote: 'These are secondary options; if you are hiring full-time, feel free to skip this section.',
    modes: [
      {
        label: 'Secondary · Remote',
        title: 'Remote collaboration',
        detail: 'Remote full-time or long-term collaboration, weekly progress syncs, driven by docs, code and demos. Fits distributed teams.',
      },
      {
        label: 'Secondary · Project',
        title: 'Project-based work',
        detail: 'A clearly scoped page, system, component library or AI app, split into stages with acceptance and settlement.',
      },
    ],
    processSummary: 'Project process (secondary)',
    processSteps: [
      { step: 'Requirement conversation', detail: 'Confirm business goals, existing systems, scope and time boundaries.' },
      { step: 'Proposal and quote', detail: 'Scope, technical approach, milestones and cost.' },
      { step: 'Build and demo', detail: 'Phased development, regular demos, timely adjustment.' },
      { step: 'Acceptance and handover', detail: 'Source, docs, deployment notes and an agreed maintenance period.' },
    ],
    processNote:
      'Staged scope, acceptance and settlement; scope, source and maintenance period are confirmed in writing. Every engagement is described at its real scope, with no unverifiable promises.',
    contactTitle: 'Contact',
    contactNote: 'In your email, briefly describe the role, team direction and expected timeline; I will reply as soon as I can.',
    emailLabel: 'Email: ',
    resumeLabel: 'Resume: ',
    resumeLink: 'Web resume',
  },
}[lang];
---
<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <article class="services wrap">
    <header class="head">
      <p class="kicker">{copy.kicker}</p>
      <h1>{copy.heading}<br />{copy.headingBreak}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="head-actions">
        <a class="btn" href={`mailto:${site.email}`}>{copy.sendEmail}</a>
        <a class="btn btn-ghost" href={localePath(lang, '/resume/')}>{copy.viewResume}</a>
      </div>
    </header>

    <section class="block">
      <h2>{copy.targetTitle}</h2>
      <dl class="intent-grid">
        <div>
          <dt>{copy.targetRoles}</dt>
          <dd>{jobTargets.join(' / ')}</dd>
        </div>
        <div>
          <dt>{copy.location}</dt>
          <dd>{copy.locationValue}</dd>
        </div>
        <div>
          <dt>{copy.status}</dt>
          <dd>{copy.statusValue}</dd>
        </div>
        <div>
          <dt>{copy.priority}</dt>
          <dd>{copy.priorityValue}</dd>
        </div>
      </dl>
      <p class="intent-note">{copy.intentNote}</p>
    </section>

    <section class="block">
      <h2>{copy.industryTitle}</h2>
      <p class="block-note">{industry.statement}</p>
      <ul class="domain-tags" aria-label={copy.industryTagsAria}>
        {industry.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </section>

    <section class="block">
      <h2>{copy.directionTitle}</h2>
      <p class="block-note">{careerDirection.statement}</p>
      <ul class="direction-tags" aria-label={copy.directionTagsAria}>
        {careerDirection.horizontal.map((item) => (
          <li>
            <span>{item.name}</span>
            <em class:list={['status', item.statusKey === 'learning' && 'is-learning']}>{item.status}</em>
          </li>
        ))}
      </ul>
      <p class="intent-note">{careerDirection.fdeNote}</p>
    </section>

    <section class="block">
      <h2>{copy.servicesTitle}</h2>
      <div class="service-grid">
        {copy.services.map((item) => (
          <div class="service">
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block">
      <h2>{copy.modesTitle}</h2>
      <p class="block-note">{copy.modesNote}</p>
      <div class="mode-grid">
        {copy.modes.map((mode) => (
          <div class="mode">
            <p class="mode-label">{mode.label}</p>
            <h3>{mode.title}</h3>
            <p class="mode-detail">{mode.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block">
      <details class="project-process">
        <summary>{copy.processSummary}</summary>
        <ol class="process">
          {copy.processSteps.map((item, index) => (
            <li>
              <span class="num">{String(index + 1).padStart(2, '0')}</span>
              <b>{item.step}</b>
              <span class="process-detail">{item.detail}</span>
            </li>
          ))}
        </ol>
        <p class="process-note">{copy.processNote}</p>
      </details>
    </section>

    <section class="block">
      <h2>{copy.contactTitle}</h2>
      <p class="contact-line">
        {copy.emailLabel}<a href={`mailto:${site.email}`}>{site.email}</a><br />
        {lang === 'zh' ? 'GitHub：' : 'GitHub: '}<a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a><br />
        {copy.resumeLabel}<a href={localePath(lang, '/resume/')}>{copy.resumeLink}</a>
      </p>
      <p class="contact-note">{copy.contactNote}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .services {
    max-width: 54rem;
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .head h1 {
    margin-top: 0.8rem;
    font-size: clamp(2rem, 4.8vw, 2.9rem);
    line-height: 1.18;
  }

  .lead {
    max-width: 58ch;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.68rem 1.35rem;
    border: 1px solid transparent;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.92rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn:hover {
    background: var(--accent);
  }

  .btn-ghost {
    border-color: var(--line-strong);
    background: transparent;
    color: var(--ink);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .block {
    margin-top: clamp(2.6rem, 6vw, 3.8rem);
  }

  .block h2 {
    font-size: 1.4rem;
  }

  .block-note {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.86rem;
  }

  /* Domain & direction -------------------------------------------- */
  .domain-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .domain-tags li {
    padding: 0.05em 0.5em;
    border: 1px solid var(--accent);
    border-radius: 2px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.7;
  }

  .direction-tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.2rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .direction-tags li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    font-size: 0.88rem;
  }

  .direction-tags .status {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    white-space: nowrap;
  }

  .direction-tags .is-learning {
    color: var(--seal);
  }

  /* Intent -------------------------------------------------------- */
  .intent-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem 2.5rem;
    margin: 1.4rem 0 0;
    padding: 1.1rem 0;
  }

  .intent-grid dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .intent-grid dd {
    margin: 0.3rem 0 0;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .intent-note {
    margin-top: 1rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  /* Services ------------------------------------------------------ */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 2.5rem;
    margin-top: 1.4rem;
  }

  .service {
    padding-top: 0.9rem;
  }

  .service h3 {
    font-size: 1.02rem;
  }

  .service p {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  /* Modes --------------------------------------------------------- */
  .mode-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 2.5rem;
    margin-top: 1.2rem;
  }

  .mode {
    padding-top: 0.9rem;
  }

  .mode-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .mode h3 {
    margin-top: 0.3rem;
    font-size: 1.02rem;
  }

  .mode-detail {
    max-width: 56ch;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  /* Process ------------------------------------------------------- */
  .project-process {
    padding: 1rem 0;
  }

  .project-process summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .project-process summary:hover {
    color: var(--accent);
  }

  .process {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .num {
    display: block;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .process b {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .process-detail {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .process-note {
    max-width: 64ch;
    margin-top: 1.2rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  /* Contact ------------------------------------------------------- */
  .contact-line {
    margin-top: 1.2rem;
    font-size: 0.98rem;
    line-height: 1.9;
  }

  .contact-line a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contact-line a:hover {
    color: var(--accent);
  }

  .contact-note {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.86rem;
  }

  @media (max-width: 700px) {
    .intent-grid,
    .service-grid,
    .mode-grid,
    .direction-tags {
      grid-template-columns: 1fr;
    }

    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
